---
title: 패션 쇼핑몰 ERD - 1단계 고객 (15개 테이블)
---
erDiagram

    %% ================= 회원 기본 =================
    MEMBER_GRADE {
        NUMBER GRADE_ID PK
        VARCHAR2 GRADE_NAME UK "WELCOME/SILVER/GOLD/VIP"
        NUMBER POINT_RATE "적립률 %"
        NUMBER DISCOUNT_RATE "할인율 %"
        NUMBER MIN_PURCHASE_AMOUNT "승급 기준 누적 구매액"
        CHAR FREE_SHIPPING "Y/N"
        NUMBER SORT_ORDER
    }

    MEMBER {
        NUMBER MEMBER_ID PK
        VARCHAR2 EMAIL UK "LOWER(EMAIL) 함수 기반 UK"
        VARCHAR2 PASSWORD_HASH "bcrypt, 소셜 전용 가입은 NULL"
        VARCHAR2 NAME
        VARCHAR2 NICKNAME UK
        VARCHAR2 PHONE_ENC "AES-256 암호문"
        CHAR PHONE_HASH "SHA-256, 검색/중복확인용"
        DATE BIRTH_DATE
        CHAR GENDER "M/F"
        CHAR CI_HASH UK "본인인증 CI 해시, 중복가입 방지"
        CHAR DI_HASH "본인인증 DI 해시"
        TIMESTAMP IDENTITY_VERIFIED_AT
        VARCHAR2 ROLE "USER/ADMIN"
        NUMBER GRADE_ID FK
        VARCHAR2 STATUS "ACTIVE/DORMANT/LOCKED/WITHDRAWN"
        NUMBER TOTAL_PURCHASE_AMOUNT "등급 산정용 캐시"
        NUMBER POINT_BALANCE "포인트 잔액 캐시"
        VARCHAR2 REFERRAL_CODE UK "내 추천 코드"
        NUMBER REFERRED_BY FK "추천인 MEMBER_ID"
        CHAR EMAIL_VERIFIED "Y/N"
        NUMBER LOGIN_FAIL_COUNT "5회 실패 시 잠금"
        TIMESTAMP LOCKED_UNTIL
        TIMESTAMP LAST_LOGIN_AT
        TIMESTAMP PASSWORD_CHANGED_AT
        TIMESTAMP WITHDRAWN_AT
        VARCHAR2 WITHDRAW_REASON
        TIMESTAMP CREATED_AT
        TIMESTAMP UPDATED_AT
    }

    MEMBER_SOCIAL {
        NUMBER SOCIAL_ID PK
        NUMBER MEMBER_ID FK
        VARCHAR2 PROVIDER UK "KAKAO/NAVER/GOOGLE"
        VARCHAR2 PROVIDER_USER_ID UK "UK(PROVIDER, PROVIDER_USER_ID)"
        TIMESTAMP CONNECTED_AT
    }

    MEMBER_BODY {
        NUMBER MEMBER_ID PK, FK "1:1"
        NUMBER HEIGHT_CM
        NUMBER WEIGHT_KG
        VARCHAR2 TOP_SIZE "XS~XXL"
        NUMBER BOTTOM_SIZE "허리 인치"
        NUMBER SHOE_SIZE "mm"
        TIMESTAMP UPDATED_AT
    }

    ADDRESS {
        NUMBER ADDRESS_ID PK
        NUMBER MEMBER_ID FK
        VARCHAR2 ALIAS "집/회사"
        VARCHAR2 RECEIVER_NAME
        VARCHAR2 RECEIVER_PHONE_ENC "AES-256 암호문"
        VARCHAR2 ZIPCODE
        VARCHAR2 ADDRESS1
        VARCHAR2 ADDRESS2
        CHAR IS_DEFAULT "Y/N, 회원당 기본 배송지 1개"
        TIMESTAMP CREATED_AT
        TIMESTAMP UPDATED_AT
    }

    %% ================= 약관 / 알림 / 취향 =================
    TERMS {
        NUMBER TERMS_ID PK
        VARCHAR2 TERMS_TYPE UK "SERVICE/PRIVACY/AGE14/MARKETING_SMS/MARKETING_EMAIL/MARKETING_PUSH"
        VARCHAR2 VERSION UK "UK(TERMS_TYPE, VERSION)"
        VARCHAR2 TITLE
        CLOB CONTENT
        CHAR IS_REQUIRED "Y/N"
        TIMESTAMP EFFECTIVE_AT
    }

    MEMBER_TERMS_AGREEMENT {
        NUMBER AGREEMENT_ID PK
        NUMBER MEMBER_ID FK
        NUMBER TERMS_ID FK
        CHAR AGREED "Y/N"
        TIMESTAMP AGREED_AT
        TIMESTAMP WITHDRAWN_AT "동의 철회 시각"
    }

    MEMBER_NOTIFICATION_SETTING {
        NUMBER MEMBER_ID PK, FK
        VARCHAR2 NOTI_TYPE PK "ORDER/DELIVERY/RESTOCK/PRICE_DROP/EVENT"
        VARCHAR2 CHANNEL PK "PUSH/SMS/EMAIL/KAKAO"
        CHAR ENABLED "Y/N, EVENT는 마케팅 동의 필요"
        TIMESTAMP UPDATED_AT
    }

    STYLE {
        NUMBER STYLE_ID PK
        VARCHAR2 NAME UK "미니멀/스트릿/캐주얼/오피스룩/아메카지/스포티"
        NUMBER SORT_ORDER
    }

    MEMBER_STYLE {
        NUMBER MEMBER_ID PK, FK
        NUMBER STYLE_ID PK, FK
        TIMESTAMP CREATED_AT
    }

    %% ================= 보안 =================
    LOGIN_HISTORY {
        NUMBER LOGIN_ID PK
        NUMBER MEMBER_ID FK "없는 계정 시도는 NULL"
        VARCHAR2 LOGIN_EMAIL "시도한 이메일"
        VARCHAR2 LOGIN_TYPE "EMAIL/KAKAO/NAVER/GOOGLE"
        VARCHAR2 RESULT "SUCCESS/FAIL_PASSWORD/FAIL_LOCKED/FAIL_NOT_FOUND"
        VARCHAR2 IP_ADDRESS
        VARCHAR2 USER_AGENT
        TIMESTAMP CREATED_AT
    }

    MEMBER_TOKEN {
        NUMBER TOKEN_ID PK
        NUMBER MEMBER_ID FK
        VARCHAR2 TOKEN_TYPE "EMAIL_VERIFY/PASSWORD_RESET"
        CHAR TOKEN_HASH UK "원문은 저장하지 않음"
        TIMESTAMP EXPIRES_AT
        TIMESTAMP USED_AT "1회용"
        TIMESTAMP CREATED_AT
    }

    MEMBER_SESSION {
        NUMBER SESSION_ID PK
        NUMBER MEMBER_ID FK
        CHAR REFRESH_TOKEN_HASH UK
        VARCHAR2 DEVICE_INFO
        VARCHAR2 IP_ADDRESS
        TIMESTAMP EXPIRES_AT
        TIMESTAMP REVOKED_AT "강제 로그아웃"
        TIMESTAMP LAST_USED_AT
        TIMESTAMP CREATED_AT
    }

    PASSWORD_HISTORY {
        NUMBER HISTORY_ID PK
        NUMBER MEMBER_ID FK
        VARCHAR2 PASSWORD_HASH "최근 3개 재사용 금지"
        TIMESTAMP CREATED_AT
    }

    PRIVACY_ACCESS_LOG {
        NUMBER LOG_ID PK
        NUMBER ADMIN_ID FK "조회한 관리자"
        NUMBER TARGET_MEMBER_ID FK "조회 대상 회원"
        VARCHAR2 ACTION "VIEW/UPDATE/EXPORT/UNMASK"
        VARCHAR2 REASON
        VARCHAR2 IP_ADDRESS
        TIMESTAMP CREATED_AT
    }

    %% ================= 관계 =================
    MEMBER_GRADE ||--o{ MEMBER : "등급"
    MEMBER |o--o{ MEMBER : "추천"
    MEMBER ||--o| MEMBER_BODY : "체형"
    MEMBER ||--o{ MEMBER_SOCIAL : "소셜 연동"
    MEMBER ||--o{ ADDRESS : "배송지"

    MEMBER ||--o{ MEMBER_TERMS_AGREEMENT : "동의"
    TERMS ||--o{ MEMBER_TERMS_AGREEMENT : "약관 버전"
    MEMBER ||--o{ MEMBER_NOTIFICATION_SETTING : "알림 설정"
    MEMBER ||--o{ MEMBER_STYLE : "선호"
    STYLE ||--o{ MEMBER_STYLE : "스타일"

    MEMBER |o--o{ LOGIN_HISTORY : "로그인 시도"
    MEMBER ||--o{ MEMBER_TOKEN : "인증 토큰"
    MEMBER ||--o{ MEMBER_SESSION : "기기 세션"
    MEMBER ||--o{ PASSWORD_HISTORY : "비밀번호 이력"
    MEMBER ||--o{ PRIVACY_ACCESS_LOG : "관리자 조회"
    MEMBER ||--o{ PRIVACY_ACCESS_LOG : "조회 대상"
