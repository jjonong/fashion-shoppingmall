// =====================================================================
// 패션 브랜드 입점형 쇼핑몰 DB 설계 (dbdiagram.io용 DBML)
// 벤치마킹: W컨셉 (디자이너 브랜드 입점, 의류·신발·가방·잡화)
// 진행 중: 고객 5개 = 5개 테이블 (묶음 단위로 컬럼까지 확정하며 추가)
// 사용법: https://dbdiagram.io/d 에 접속 → 왼쪽 편집기에 이 파일 내용을 전체 붙여넣기
// DBMS: MySQL 8.0 (8.0.16 이상: CHECK 제약 적용, 8.0.13 이상: 함수 기반 인덱스)
// 이전 설계 보관: docs/archive_interior/ (인테리어몰), docs/archive_fashion/ (패션몰 Oracle), docs/archive_oracle/
// =====================================================================

Project fashion_mall {
  database_type: 'MySQL'
  Note: '''
  패션 브랜드 입점형 쇼핑몰 포트폴리오 DB (MySQL 8.0, InnoDB, utf8mb4 / utf8mb4_0900_ai_ci)
  - 여러 패션 브랜드가 입점해 의류·신발·가방·잡화를 판매 (W컨셉 벤치마킹)
  - 이름은 소문자 snake_case
  - AUTO_INCREMENT 쓰지 않음: 회원은 아이디(varchar)가 PK, 하위 테이블은 부모 키 + 번호/코드 복합키
  - 상태값은 VARCHAR + CHECK, Y/N은 CHAR(1) + CHECK
  - created_at DEFAULT CURRENT_TIMESTAMP, updated_at은 ON UPDATE CURRENT_TIMESTAMP
  - 탈퇴는 soft delete + 개인정보 마스킹
  '''
}

// =====================================================================
// 고객 - 회원 기본
// =====================================================================

Table member_account [note: '[회원] 구매 고객 계정. 브랜드 관리자·운영자 계정은 별도 테이블'] {
  member_id varchar(20) [pk, note: '[회원 아이디] 가입 시 직접 입력(소셜 가입도 한 번 정함). 영문 소문자로 시작, 영문 소문자·숫자 4~20자 (앱 검증). 변경 불가, 탈퇴 후에도 행이 남아 재사용 불가']
  password_hash varchar(255) [note: '[회원 비밀번호] 평문은 어디에도 저장하지 않고(로그 포함) bcrypt 단방향 해시(일방향 암호화, 개인정보 안전성 확보조치 기준). 솔트는 해시 문자열에 포함되어 별도 컬럼 없음. 원래 값으로 복원 불가라 비밀번호 찾기는 재설정만. 소셜 전용 가입은 NULL']
  name varchar(50) [not null, note: '[회원 이름] 실명. 가입 시 휴대폰 본인인증 결과로 채움(직접 입력 아님). 탈퇴 시 탈퇴회원']
  nickname varchar(20) [not null, note: '[회원 닉네임] 리뷰·문의에 표시. 2~12자 한글/영문/숫자/_ (앱 검증). 탈퇴 시 deleted_{아이디}']
  email varchar(100) [not null, note: '[회원 이메일] 평문 저장(법적 암호화 대상 아님, 암호화하면 UNIQUE·대소문자 무시 비교·아이디 찾기가 안 됨). 관리자 화면은 마스킹, 조회는 접근 기록. 대소문자 무시 콜레이션(utf8mb4_0900_ai_ci)이라 UNIQUE만으로 대소문자 중복 방지. 탈퇴 시 withdrawn_{아이디}@deleted.local로 마스킹']
  phone_enc varchar(255) [not null, note: '[회원 휴대폰 번호] 가입 시 휴대폰 본인인증 결과로 채움. AES-256 암호문. 문자 발송·화면 표시처럼 실제 번호가 필요할 때 복호화. 같은 번호도 매번 다른 암호문(IV)이라 검색에는 phone_hash 사용. 법적 의무는 아니지만 유출 시 피해(스팸·피싱)가 커서 추가 보호']
  phone_hash char(64) [not null, note: '[회원 휴대폰 번호 검색값] HMAC-SHA256(서버 비밀 키). 같은 번호면 항상 같은 값이라 아이디 찾기·같은 번호 가입 확인에 검색용으로 사용. 번호는 경우의 수가 약 1억 개라 단순 SHA-256은 전부 대입해 풀리므로 키를 섞음']
  birth_date date [not null, note: '[회원 생년월일] 가입 시 휴대폰 본인인증 결과로 채움(직접 입력 아님). 만 14세 미만 가입 불가(앱 검증). 생일 쿠폰, 연령대 맞춤 추천 기본값']
  gender char(1) [not null, note: '[회원 성별] F/M. 가입 시 휴대폰 본인인증 결과로 채움(직접 입력 아님). 맞춤 추천 피드 기본값']
  profile_image_url varchar(500) [note: '[회원 프로필 사진 경로] 선택 입력. 리뷰·스타일 게시글에 표시. 탈퇴 시 NULL']
  profile_intro varchar(200) [note: '[회원 소개글] 선택 입력. 탈퇴 시 NULL']
  ci_hash char(64) [note: '[회원 중복 가입 확인값(CI)] 휴대폰 본인인증 시 본인확인기관이 주는 연계정보(CI, 같은 사람이면 어느 사이트든 같은 값)를 HMAC-SHA256(서버 비밀 키)으로 저장. 원래 값은 볼 일 없이 비교만 함. 같은 사람은 계정 1개만 허용(가입 혜택 반복 수령 방지). 탈퇴 시 NULL']
  join_method varchar(20) [not null, note: '[회원 가입 수단] EMAIL/KAKAO/NAVER/FACEBOOK/INSTAGRAM/GOOGLE/APPLE. 처음 가입한 방법 (이후 연동한 소셜 계정은 member_social)']
  join_channel varchar(20) [not null, note: '[회원 가입 경로] PC_WEB/MOBILE_WEB/APP_IOS/APP_ANDROID']
  verified_at datetime [not null, note: '[회원 본인인증일시] 가입 시 휴대폰 본인인증 필수. 재인증 시 갱신']
  status varchar(20) [not null, default: 'ACTIVE', note: '[회원 상태] ACTIVE/DORMANT/SUSPENDED/WITHDRAWN. 로그인 잠금은 상태가 아니라 locked_until로 판단']
  login_fail_count tinyint [not null, default: 0, note: '[회원 연속 로그인 실패 횟수] 로그인 성공 시 0으로 초기화']
  locked_until datetime [note: '[회원 로그인 잠금 해제일시] 5회 연속 실패 시 30분 뒤 시각으로 설정']
  last_login_at datetime [note: '[회원 마지막 로그인일시] 휴면 전환 배치 기준']
  dormant_notice_sent_at datetime [note: '[회원 휴면 예정 안내일시] 마지막 로그인 11개월 시점에 안내, 1년 미접속 시 DORMANT']
  suspended_until datetime [note: '[회원 이용 정지 종료일시] SUSPENDED 기한. 지나면 배치로 ACTIVE']
  nickname_changed_at datetime [note: '[회원 닉네임 변경일시] 변경 후 30일간 재변경 불가']
  withdraw_reason varchar(20) [note: '[회원 탈퇴 사유] LOW_USAGE/NO_PRODUCT/PRICE/DELIVERY/SERVICE/PRIVACY/REJOIN/ETC. 탈퇴 신청 시 선택']
  withdraw_comment varchar(500) [note: '[회원 탈퇴 의견] 탈퇴 신청 시 자유 의견, 서비스 개선 통계용']
  withdrawn_at datetime [note: '[회원 탈퇴일시] 탈퇴 시 마스킹: 이름·닉네임·이메일, ci_hash·프로필 사진·소개글 NULL']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[회원 가입일시]']
  updated_at datetime [note: '[회원 정보 수정일시]']

  indexes {
    email [unique, name: 'uk_member_email']
    nickname [unique, name: 'uk_member_nickname']
    ci_hash [unique, name: 'uk_member_ci', note: '같은 사람(CI)은 계정 1개. NULL(미인증·탈퇴)은 중복 허용']
    phone_hash [name: 'ix_member_phone_hash', note: '휴대폰 번호로 아이디 찾기·가입 확인']
    (status, last_login_at) [name: 'ix_member_dormant_target', note: '휴면 안내·전환 대상 배치 조회']
  }
}

Table member_social [note: '[소셜 계정 연동] 한 회원이 여러 소셜 계정을 연결 가능 (제공자별 1개)'] {
  member_id varchar(20) [not null, note: '[소셜 연동 회원 아이디]']
  provider varchar(20) [not null, note: '[소셜 제공자] KAKAO/NAVER/FACEBOOK/INSTAGRAM/GOOGLE/APPLE. 회원당 제공자별 1개라 (회원 아이디, 제공자)를 PK로 사용']
  provider_user_id varchar(100) [not null, note: '[소셜 제공자 회원 식별값] 소셜 서비스의 회원 고유 ID']
  provider_email varchar(100) [note: '[소셜 계정 이메일] 제공자가 준 이메일 (참고용, 로그인 이메일과 다를 수 있음)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[소셜 계정 연동일시]']

  indexes {
    (provider, provider_user_id) [unique, name: 'uk_member_social_provider', note: '같은 소셜 계정은 한 회원에게만']
    (member_id, provider) [pk, note: '회원당 제공자별 1개. member_id 선두라 FK 인덱스 겸용']
  }
}

Table member_body [note: '[회원 체형] member_account와 1:1. 사이즈 추천, "나와 비슷한 체형" 리뷰 필터'] {
  member_id varchar(20) [pk, note: '[체형 정보 회원 아이디] member_account와 1:1']
  height_cm smallint [note: '[회원 키(cm)]']
  weight_kg smallint [note: '[회원 몸무게(kg)]']
  top_size varchar(10) [note: '[회원 평소 상의 사이즈] XS/S/M/L/XL/XXL/FREE']
  bottom_size varchar(10) [note: '[회원 평소 하의 사이즈] 허리 inch(25~36) 또는 XS~XXL']
  shoe_size_mm smallint [note: '[회원 평소 신발 사이즈(mm)] 220~300, 5 단위 (앱 검증)']
  foot_width varchar(10) [note: '[회원 발볼 너비] NARROW/NORMAL/WIDE']
  is_review_public char(1) [not null, default: 'Y', note: '[회원 체형 리뷰 공개 여부] Y/N. Y면 리뷰에 키·몸무게·평소 사이즈 표시']
  updated_at datetime [note: '[회원 체형 수정일시]']
}

Table address [note: '[배송지] 회원당 여러 개, 기본 배송지는 1개'] {
  member_id varchar(20) [not null, note: '[배송지 소유 회원 아이디]']
  address_no smallint [not null, note: '[배송지 번호] 회원별 1부터. 앱이 그 회원의 MAX+1로 부여 (AUTO_INCREMENT 아님)']
  address_name varchar(20) [note: '[배송지 이름] 집/회사']
  recipient_name varchar(50) [not null, note: '[배송지 받는 분 이름]']
  recipient_phone_enc varchar(255) [not null, note: '[배송지 받는 분 연락처] AES-256 암호문']
  zipcode char(5) [not null, note: '[배송지 우편번호] 5자리 국가기초구역번호']
  address1 varchar(200) [not null, note: '[배송지 기본 주소] 도로명 주소']
  address2 varchar(200) [note: '[배송지 상세 주소]']
  is_default char(1) [not null, default: 'N', note: '[기본 배송지 여부] Y/N']
  delivery_request varchar(100) [note: '[배송지 배송 요청사항] 예: 부재 시 문 앞. 주문 시 기본값으로 복사']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[배송지 등록일시]']
  updated_at datetime [note: '[배송지 수정일시]']

  indexes {
    (member_id, address_no) [pk, note: 'member_id 선두라 FK 인덱스 겸용']
    `CASE WHEN is_default = 'Y' THEN member_id END` [unique, name: 'ux_address_default', note: '회원당 기본 배송지 1개. MySQL 8.0.13+ 함수 기반 인덱스 (NULL은 중복 허용)']
  }
}

Table member_refund_account [note: '[회원 환불 계좌] member_account와 1:1. 무통장·가상계좌 결제 취소 시 환불받을 계좌'] {
  member_id varchar(20) [pk, note: '[환불 계좌 회원 아이디] member_account와 1:1']
  bank_code char(3) [not null, note: '[환불 은행 코드] 금융결제원 3자리 은행 코드 (예: 004 국민, 088 신한)']
  account_no_enc varchar(255) [not null, note: '[환불 계좌번호] AES-256 암호문. 계좌번호는 법정 암호화 대상. 화면에는 뒤 4자리만 표시']
  account_holder varchar(50) [not null, note: '[환불 계좌 예금주]']
  verified_at datetime [note: '[환불 계좌 실명 확인일시] 예금주 조회 API로 확인. NULL이면 미확인(환불 전 확인)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[환불 계좌 등록일시]']
  updated_at datetime [note: '[환불 계좌 수정일시]']
}

// =====================================================================
// 관계
// =====================================================================

Ref: member_social.member_id > member_account.member_id [delete: cascade]
Ref: member_body.member_id - member_account.member_id [delete: cascade]
Ref: address.member_id > member_account.member_id [delete: cascade]
Ref: member_refund_account.member_id - member_account.member_id [delete: cascade]

// =====================================================================
// 묶음
// =====================================================================

TableGroup member_basic [note: '고객 - 회원 기본'] {
  member_account
  member_social
  member_body
  address
  member_refund_account
}
