// =====================================================================
// 인테리어 가구몰 + 커뮤니티 DB 설계 (dbdiagram.io용 DBML)
// 벤치마킹: 오늘의집 (스토어 + 커뮤니티). 자사몰 규모에 맞춰 커뮤니티는 구매 고객 사진·집들이 + 브랜드 매거진으로 축소
// 1단계 고객 18개 + 2단계 상품 30개 + 3단계 커뮤니티 12개 = 60개 테이블
// 사용법: https://dbdiagram.io/d 에 접속 → 왼쪽 편집기에 이 파일 내용을 전체 붙여넣기
// DBMS: MySQL 8.0 (8.0.16 이상: CHECK 제약 적용, 8.0.13 이상: 함수 기반 인덱스)
// 이전 설계 보관: docs/archive_fashion/ (패션몰), docs/archive_oracle/ (Oracle 버전)
// =====================================================================

Project interior_mall {
  database_type: 'MySQL'
  Note: '''
  인테리어 가구몰 + 커뮤니티 포트폴리오 DB (MySQL 8.0, InnoDB, utf8mb4 / utf8mb4_0900_ai_ci)
  - 여러 브랜드 가구/소품을 자사가 직접 판매 (입점사 정산 없음)
  - 커뮤니티 글(사진/집들이/매거진)에 상품을 태그해서 스토어로 연결
  - 이름은 소문자 snake_case, PK는 BIGINT AUTO_INCREMENT
  - 상태값은 VARCHAR + CHECK, Y/N은 CHAR(1) + CHECK
  - created_at DEFAULT CURRENT_TIMESTAMP, updated_at은 ON UPDATE CURRENT_TIMESTAMP
  - 탈퇴는 soft delete + 개인정보 마스킹
  '''
}

// =====================================================================
// 1단계: 고객 - 회원 기본
// =====================================================================

Table member_grade [note: '회원 등급 (혜택을 DB에서 바로 변경)'] {
  grade_id bigint [pk, increment]
  grade_name varchar(20) [not null, unique, note: 'WELCOME/SILVER/GOLD/VIP']
  point_rate decimal(5,2) [not null, default: 0, note: '적립률 %']
  discount_rate decimal(5,2) [not null, default: 0, note: '할인율 %']
  min_purchase_amount bigint [not null, default: 0, note: '승급 기준 누적 구매액']
  free_shipping char(1) [not null, default: 'N', note: 'Y/N (일반택배에만 적용, 화물/설치배송 제외)']
  sort_order smallint [not null]
}

Table member_account [note: '회원 (커뮤니티 프로필 포함)'] {
  member_id bigint [pk, increment]
  email varchar(200) [not null, unique, note: '대소문자 무시 콜레이션(utf8mb4_0900_ai_ci)이라 UNIQUE만으로 대소문자 중복 방지. 탈퇴 시 withdrawn_{ID}@deleted.local로 마스킹']
  password_hash varchar(100) [note: 'bcrypt 해시. 소셜 전용 가입은 NULL']
  name varchar(50) [not null, note: '실명. 탈퇴 시 탈퇴회원']
  nickname varchar(30) [not null, unique, note: '커뮤니티 표시 이름. 2~12자 한글/영문/숫자/_ (앱 검증), forbidden_word 금칙어 불가, 최근 30일 내 다른 회원이 쓰던 닉네임 불가(nickname_history). 탈퇴 시 deleted_{ID}로 변경']
  nickname_changed_at datetime [note: '마지막 닉네임 변경 시각. 변경 후 30일간 재변경 불가']
  profile_image_url varchar(500)
  introduction varchar(200) [note: '프로필 한 줄 소개']
  phone_enc varchar(200) [note: '휴대폰 번호 AES-256 암호문']
  phone_hash char(64) [note: '휴대폰 번호 SHA-256 (검색/중복확인용)']
  birth_date date
  gender char(1) [note: 'M/F']
  ci_hash char(64) [unique, note: '본인인증 CI 해시. 중복 가입 방지']
  di_hash char(64) [note: '본인인증 DI 해시']
  identity_verified_at datetime
  role varchar(20) [not null, default: 'USER', note: 'USER/ADMIN/EDITOR(매거진 작성·큐레이션)']
  grade_id bigint [not null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE/DORMANT(휴면)/SUSPENDED(활동 정지)/WITHDRAWN. 바뀔 때마다 member_status_history에 기록. 로그인 잠금은 상태가 아니라 locked_until로 판단']
  status_changed_at datetime [note: '마지막 상태 변경 시각']
  suspended_until datetime [note: 'SUSPENDED 기한. 지나면 배치로 ACTIVE 복구']
  dormant_notice_sent_at datetime [note: '휴면 예정 안내 발송 시각. last_login_at 기준 11개월에 안내, 1년 미접속 시 배치로 DORMANT (상태값만 변경, 분리보관 없음)']
  total_purchase_amount bigint [not null, default: 0, note: '등급 산정용 캐시']
  point_balance bigint [not null, default: 0, note: '포인트 잔액 캐시']
  post_count int [not null, default: 0, note: '공개 글 수 캐시']
  referral_code varchar(20) [unique, note: '내 추천 코드']
  referred_by bigint [note: '나를 추천한 회원']
  email_verified char(1) [not null, default: 'N', note: 'Y/N']
  login_fail_count tinyint [not null, default: 0, note: '5회 실패 시 30분 잠금']
  locked_until datetime
  last_login_at datetime
  password_changed_at datetime
  withdrawn_at datetime
  withdraw_reason varchar(500)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime

  indexes {
    phone_hash [name: 'ix_member_phone_hash']
    grade_id [name: 'ix_member_grade']
    referred_by [name: 'ix_member_referred_by']
    (status, last_login_at) [name: 'ix_member_dormant_target', note: '휴면 안내·전환 대상 배치 조회']
  }
}

Table member_social [note: '소셜 계정 연동 (한 회원이 여러 개 연결 가능)'] {
  social_id bigint [pk, increment]
  member_id bigint [not null]
  provider varchar(20) [not null, note: 'KAKAO/NAVER/GOOGLE/APPLE']
  provider_user_id varchar(100) [not null, note: '소셜 서비스의 회원 고유 ID']
  connected_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (provider, provider_user_id) [unique, name: 'uk_member_social']
    member_id [name: 'ix_member_social_member']
  }
}

Table member_home [note: '회원 주거 정보 (맞춤 상품 추천, 집들이 작성 시 기본값)'] {
  member_id bigint [pk, note: 'member_account와 1:1']
  housing_type varchar(20) [note: 'APARTMENT/VILLA/HOUSE/OFFICETEL/ONE_ROOM/ETC']
  area_pyeong smallint [note: '평수']
  room_count tinyint
  family_type varchar(20) [note: 'SINGLE/COUPLE/WITH_KIDS/WITH_PARENTS/SHARE/ETC']
  has_pet char(1) [note: 'Y/N']
  move_in_planned_at date [note: '이사 예정일 (이사 시즌 기획전 타깃)']
  updated_at datetime
}

Table address [note: '배송지 (회원당 여러 개, 기본 배송지는 1개)'] {
  address_id bigint [pk, increment]
  member_id bigint [not null]
  alias varchar(30) [note: '집/회사/새 집']
  receiver_name varchar(50) [not null]
  receiver_phone_enc varchar(200) [not null, note: 'AES-256 암호문']
  zipcode varchar(10) [not null]
  address1 varchar(200) [not null]
  address2 varchar(200)
  floor_no smallint [note: '가구 배송용: 층수 (지하는 음수). 사다리차·계단 운반비 계산에 사용']
  has_elevator char(1) [note: '가구 배송용: 엘리베이터 Y/N (사다리차 필요 판단)']
  delivery_request varchar(200) [note: '배송 요청사항 (예: 부재 시 문 앞, 설치 전 연락 주세요). 주문 시 기본값으로 복사']
  entrance_password_enc varchar(200) [note: '공동현관 비밀번호 AES-256 암호문. 배송 기사 전달용, 화면에는 마스킹 표시']
  is_default char(1) [not null, default: 'N', note: 'Y/N']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime

  indexes {
    member_id [name: 'ix_address_member']
    `CASE WHEN is_default = 'Y' THEN member_id END` [unique, name: 'ux_address_default', note: '회원당 기본 배송지 1개. MySQL 8.0.13+ 함수 기반 인덱스 (NULL은 중복 허용)']
  }
}

// =====================================================================
// 1단계: 고객 - 약관 / 알림 / 취향
// =====================================================================

Table terms [note: '약관 (버전 관리)'] {
  terms_id bigint [pk, increment]
  terms_type varchar(30) [not null, note: 'SERVICE/PRIVACY/AGE14/COMMUNITY(커뮤니티 운영정책)/MARKETING_SMS/MARKETING_EMAIL/MARKETING_PUSH']
  version varchar(10) [not null]
  title varchar(100) [not null]
  content mediumtext [not null]
  is_required char(1) [not null, note: 'Y/N']
  effective_at datetime [not null, note: '시행일']

  indexes {
    (terms_type, version) [unique, name: 'uk_terms_type_version']
  }
}

Table member_terms_agreement [note: '약관 동의/철회 이력'] {
  agreement_id bigint [pk, increment]
  member_id bigint [not null]
  terms_id bigint [not null]
  agreed char(1) [not null, note: 'Y/N']
  agreed_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  withdrawn_at datetime [note: '동의 철회 시각']

  indexes {
    member_id [name: 'ix_mta_member']
    terms_id [name: 'ix_mta_terms']
  }
}

Table member_notification_setting [note: '알림 수신 설정. EVENT(광고성)는 마케팅 약관 동의가 있어야 발송'] {
  member_id bigint [not null]
  noti_type varchar(20) [not null, note: 'ORDER/DELIVERY/RESTOCK/PRICE_DROP/EVENT/COMMENT/LIKE']
  channel varchar(10) [not null, note: 'PUSH/SMS/EMAIL/KAKAO']
  enabled char(1) [not null, default: 'Y', note: 'Y/N']
  updated_at datetime

  indexes {
    (member_id, noti_type, channel) [pk]
  }
}

Table style [note: '인테리어 스타일 (회원 취향, 상품, 커뮤니티 글에서 함께 사용)'] {
  style_id bigint [pk, increment]
  name varchar(30) [not null, unique, note: '모던/북유럽/빈티지/내추럴/프로방스/클래식/미니멀/인더스트리얼/한국아시아/유니크']
  sort_order smallint [not null]
}

Table member_style [note: '회원 선호 스타일'] {
  member_id bigint [not null]
  style_id bigint [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (member_id, style_id) [pk]
    style_id [name: 'ix_member_style_style']
  }
}

// =====================================================================
// 1단계: 고객 - 보안
// =====================================================================

Table login_history [note: '로그인 시도 이력 (이상 로그인 탐지, 새 기기 알림)'] {
  login_id bigint [pk, increment]
  member_id bigint [note: '없는 계정으로 시도하면 NULL']
  login_email varchar(200) [note: '시도한 이메일']
  login_type varchar(20) [not null, note: 'EMAIL/KAKAO/NAVER/GOOGLE/APPLE']
  result varchar(20) [not null, note: 'SUCCESS/FAIL_PASSWORD/FAIL_LOCKED/FAIL_NOT_FOUND']
  ip_address varchar(45) [not null, note: 'IPv6 포함']
  user_agent varchar(500)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (member_id, created_at) [name: 'ix_login_history_member']
    (ip_address, created_at) [name: 'ix_login_history_ip']
  }
}

Table member_token [note: '이메일 인증, 비밀번호 재설정용 1회용 토큰'] {
  token_id bigint [pk, increment]
  member_id bigint [not null]
  token_type varchar(20) [not null, note: 'EMAIL_VERIFY/PASSWORD_RESET']
  token_hash char(64) [not null, unique, note: 'SHA-256. 원문은 저장하지 않음']
  expires_at datetime [not null]
  used_at datetime [note: '사용하면 기록, 재사용 불가']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    member_id [name: 'ix_member_token_member']
  }
}

Table member_session [note: '기기별 로그인 세션 (리프레시 토큰)'] {
  session_id bigint [pk, increment]
  member_id bigint [not null]
  refresh_token_hash char(64) [not null, unique, note: 'SHA-256']
  device_info varchar(200)
  ip_address varchar(45)
  expires_at datetime [not null]
  revoked_at datetime [note: '강제 로그아웃, 비밀번호 변경 시 전체 폐기']
  last_used_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (member_id, revoked_at) [name: 'ix_member_session_member']
  }
}

Table password_history [note: '비밀번호 변경 이력 (최근 3개 재사용 금지)'] {
  history_id bigint [pk, increment]
  member_id bigint [not null]
  password_hash varchar(100) [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (member_id, created_at) [name: 'ix_password_history_member']
  }
}

Table privacy_access_log [note: '관리자 개인정보 접근 기록 (개인정보 안전성 확보조치 기준)'] {
  log_id bigint [pk, increment]
  admin_id bigint [not null, note: '조회한 관리자']
  target_member_id bigint [not null, note: '조회 대상 회원']
  action varchar(20) [not null, note: 'VIEW/UPDATE/EXPORT/UNMASK']
  reason varchar(500) [not null]
  ip_address varchar(45) [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    admin_id [name: 'ix_pal_admin']
    (target_member_id, created_at) [name: 'ix_pal_target']
  }
}

// =====================================================================
// 1단계: 고객 - 상태 / 닉네임 정책
// =====================================================================

Table member_status_history [note: '회원 상태 변경 이력 (가입·휴면·정지·탈퇴 전환 사유와 처리자)'] {
  history_id bigint [pk, increment]
  member_id bigint [not null]
  from_status varchar(20) [note: '가입 시 NULL']
  to_status varchar(20) [not null, note: 'ACTIVE/DORMANT/SUSPENDED/WITHDRAWN']
  reason_type varchar(30) [not null, note: 'SIGN_UP/DORMANT_BATCH/DORMANT_RELEASE/SANCTION/SANCTION_END/WITHDRAW/ADMIN_CHANGE']
  reason varchar(500) [note: '상세 사유 (정지 사유, 탈퇴 사유 등)']
  effective_until datetime [note: 'SUSPENDED 기한']
  report_id bigint [note: '정지 근거가 된 신고']
  changed_by bigint [note: '처리 관리자. 배치·본인 처리는 NULL']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (member_id, created_at) [name: 'ix_msh_member', note: '회원별 상태 이력 (누적 정지 횟수 판단)']
    (to_status, created_at) [name: 'ix_msh_status', note: '기간별 휴면·탈퇴 통계']
    report_id [name: 'ix_msh_report']
    changed_by [name: 'ix_msh_changed_by']
  }
}

Table nickname_history [note: '닉네임 변경 이력 (사칭 방지, 신고 추적)'] {
  history_id bigint [pk, increment]
  member_id bigint [not null]
  nickname varchar(30) [not null, note: '이전 닉네임']
  used_from datetime [not null]
  used_until datetime [not null, note: '변경 시각. 이후 30일간 다른 회원이 이 닉네임 사용 불가']

  indexes {
    (nickname, used_until) [name: 'ix_nickname_history_nickname', note: '최근 30일 내 사용된 닉네임인지 확인']
    (member_id, used_until) [name: 'ix_nickname_history_member']
  }
}

Table forbidden_word [note: '금칙어 (닉네임, 글, 댓글 공용)'] {
  word_id bigint [pk, increment]
  word varchar(50) [not null, unique]
  match_type varchar(10) [not null, default: 'CONTAINS', note: 'EXACT(완전 일치)/CONTAINS(포함). 공백·특수문자 제거 후 비교 (앱)']
  target varchar(10) [not null, default: 'ALL', note: 'NICKNAME/CONTENT/ALL']
  is_active char(1) [not null, default: 'Y']
  created_by bigint [not null, note: '등록 관리자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (target, is_active) [name: 'ix_forbidden_word_target']
    created_by [name: 'ix_forbidden_word_created_by']
  }
}

// =====================================================================
// 2단계: 상품 - 분류 / 브랜드 / 배송
// =====================================================================

Table brand [note: '브랜드'] {
  brand_id bigint [pk, increment]
  name_ko varchar(100) [not null]
  name_en varchar(100) [not null, unique]
  logo_url varchar(500)
  description varchar(1000)
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE/HIDDEN']
  like_count int [not null, default: 0, note: '캐시']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime
}

Table category [note: '카테고리 최대 4단계 (예: 가구 > 침대 > 침대프레임 > 수납침대)'] {
  category_id bigint [pk, increment]
  parent_id bigint [note: '최상위는 NULL']
  name varchar(50) [not null]
  depth tinyint [not null, note: '1~4']
  sort_order smallint [not null]
  icon_url varchar(500) [note: '카테고리 아이콘 (가구/패브릭/조명/가전/주방/데코/수납/생활/반려동물)']
  is_active char(1) [not null, default: 'Y', note: 'Y/N']

  indexes {
    (parent_id, name) [unique, name: 'uk_category_parent_name']
  }
}

Table shipping_policy [note: '배송 정책. 가구는 배송 방식과 비용이 상품마다 크게 다름'] {
  policy_id bigint [pk, increment]
  name varchar(100) [not null, note: '예: 대형가구 설치배송(수도권)']
  delivery_type varchar(20) [not null, note: 'PARCEL(일반택배)/FREIGHT(화물택배)/DIRECT_INSTALL(업체 직접 설치배송)']
  shipping_fee bigint [not null, default: 0, note: '기본 배송비']
  free_threshold bigint [note: '이 금액 이상 무료배송 (권역 추가비·양중비는 별도). NULL이면 조건 없음']
  ladder_floor_from smallint [note: '엘리베이터가 없을 때 이 층 이상이면 사다리차. NULL이면 사다리차 대상 아님 (소형 택배)']
  ladder_fee bigint [not null, default: 0, note: '사다리차 비용']
  stair_fee_per_floor bigint [not null, default: 0, note: '엘리베이터 없이 계단으로 옮길 때 층당 비용 (2층부터, 사다리차 기준 층 미만)']
  return_fee bigint [not null, note: '반품 배송비 (편도)']
  exchange_fee bigint [not null, note: '교환 배송비 (왕복)']
  lead_days smallint [not null, note: '결제 후 출고까지 소요일. 주문제작 가구는 길다']
  same_day_cutoff varchar(5) [note: '오늘출발 마감 시각 HH24:MI. NULL이면 오늘출발 아님']
  is_bundle_allowed char(1) [not null, default: 'Y', note: '다른 상품과 묶음배송 가능 여부']
  is_active char(1) [not null, default: 'Y']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

// =====================================================================
// 2단계: 상품 - 상품 → 옵션 → SKU
// =====================================================================

Table product [note: '상품 (옵션 공통 정보)'] {
  product_id bigint [pk, increment]
  brand_id bigint [not null]
  category_id bigint [not null, note: '최하위 카테고리']
  shipping_policy_id bigint [not null]
  model_code varchar(30) [not null, unique, note: '모델명/품번']
  name varchar(200) [not null, note: '검색용 FULLTEXT 인덱스 WITH PARSER ngram (DDL에서 생성, 한글 부분 일치)']
  product_type varchar(10) [not null, default: 'SINGLE', note: 'SINGLE/SET. SET은 product_set_item으로 구성 (예: 식탁 + 의자 4개)']
  sale_type varchar(20) [not null, default: 'NORMAL', note: 'NORMAL/PRE_ORDER/MADE_TO_ORDER(주문제작). PRE_ORDER는 SKU stock을 예약 한도로 사용, MADE_TO_ORDER는 재고를 차감하지 않고 lead_days만큼 제작 후 출고']
  ship_expected_date date [note: '예약 판매 출고 예정일']
  max_per_order smallint [note: '주문 1건당 최대 수량. NULL이면 제한 없음']
  list_price bigint [not null, note: '정가']
  sale_price bigint [not null, note: '판매가. CHECK sale_price <= list_price. 할인율은 계산']
  description mediumtext [note: '상세페이지 본문 (HTML)']
  width_mm int [note: '대표 사이즈 가로 (옵션별 사이즈는 SKU)']
  depth_mm int [note: '세로(깊이)']
  height_mm int [note: '높이']
  weight_kg decimal(6,1)
  assembly_type varchar(20) [not null, default: 'NONE', note: 'NONE(완제품)/SELF(자가조립)/INSTALL(설치 기사 조립)']
  status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT/ON_SALE/SOLD_OUT/STOPPED. 품절 기준은 SKU 재고: 판매 중인 SKU가 모두 stock = 0이면 시스템이 SOLD_OUT, 재입고되면 ON_SALE (changed_by NULL)']
  sale_start_at datetime
  sale_end_at datetime
  view_count int [not null, default: 0, note: '캐시']
  scrap_count int [not null, default: 0, note: '캐시. 오늘의집처럼 찜 = 스크랩']
  review_count int [not null, default: 0, note: '캐시']
  avg_rating decimal(2,1) [not null, default: 0, note: '캐시']
  sales_count int [not null, default: 0, note: '캐시']
  tagged_post_count int [not null, default: 0, note: '캐시. 이 상품이 태그된 커뮤니티 글 수 (상세페이지 "이 상품이 쓰인 사진")']
  created_by bigint [not null, note: '등록 관리자']
  updated_by bigint [note: '수정 관리자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime

  indexes {
    (category_id, status, sale_price) [name: 'ix_product_category']
    (brand_id, status) [name: 'ix_product_brand']
    (status, sales_count) [name: 'ix_product_best', note: 'sales_count DESC']
    shipping_policy_id [name: 'ix_product_shipping']
    created_by [name: 'ix_product_created_by']
    updated_by [name: 'ix_product_updated_by']
  }
}

Table product_notice [note: '상품정보제공고시 (가구 필수 표시 항목)'] {
  product_id bigint [pk, note: 'product와 1:1']
  kc_cert_info varchar(200) [not null, note: 'KC 인증 정보 (해당 없으면 "해당 없음")']
  color_info varchar(200) [not null]
  components varchar(500) [not null, note: '구성품']
  material varchar(200) [not null, note: '주요 소재 (법정 표기 문구)']
  manufacturer varchar(100) [not null, note: '제조자/수입자']
  origin varchar(50) [not null, note: '제조국 (구성품별로 다르면 모두 표기)']
  size_info varchar(200) [not null]
  delivery_install_fee varchar(300) [not null, note: '배송·설치비용']
  quality_assurance varchar(500) [not null, note: '품질보증기준']
  as_contact varchar(100) [not null, note: 'A/S 책임자와 전화번호']
}

Table product_option_group [note: '옵션 그룹 (색상, 사이즈, 매트리스 포함 여부 등). 가구는 옵션 축이 상품마다 다름'] {
  option_group_id bigint [pk, increment]
  product_id bigint [not null]
  name varchar(50) [not null, note: '예: 색상 / 사이즈 / 구성']
  sort_order smallint [not null]

  indexes {
    (product_id, name) [unique, name: 'uk_option_group_name']
  }
}

Table product_option_value [note: '옵션 값 (화이트 오크 / Q(퀸) / 매트리스 포함)'] {
  option_value_id bigint [pk, increment]
  option_group_id bigint [not null]
  name varchar(50) [not null]
  color_family_id bigint [note: '색상 옵션이면 컬러 계열 (필터용)']
  sort_order smallint [not null]

  indexes {
    (option_group_id, name) [unique, name: 'uk_option_value_name']
    color_family_id [name: 'ix_option_value_color_family']
  }
}

Table product_sku [note: 'SKU = 옵션 값 조합. 재고, 장바구니, 주문의 기준 단위. 옵션이 없는 상품도 SKU 1개'] {
  sku_id bigint [pk, increment]
  product_id bigint [not null]
  option_key varchar(200) [not null, note: '옵션 값 ID를 오름차순으로 이은 문자열 (예: 12-35). 옵션 없으면 DEFAULT. 같은 조합 중복 방지']
  sku_code varchar(50) [not null, unique, note: '모델명-옵션코드']
  barcode varchar(30) [unique, note: '입출고 스캔용']
  extra_price bigint [not null, default: 0, note: '옵션 추가금 (퀸 +50,000)']
  width_mm int [note: '옵션별 실제 사이즈 (침대 SS/Q/K)']
  depth_mm int
  height_mm int
  stock int [not null, default: 0, note: '판매 가능 재고 (주문 시 차감). CHECK stock >= 0. 0이 되면 SKU status = SOLD_OUT']
  safety_stock int [not null, default: 0, note: '품절 임박 기준']
  status varchar(20) [not null, default: 'ON_SALE', note: 'ON_SALE/SOLD_OUT/STOPPED']
  version int [not null, default: 0, note: '낙관적 락']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime

  indexes {
    (product_id, option_key) [unique, name: 'uk_product_sku_option_key']
  }
}

Table product_sku_option [note: 'SKU가 어떤 옵션 값의 조합인지 (그룹당 값 1개)'] {
  sku_id bigint [not null]
  option_group_id bigint [not null]
  option_value_id bigint [not null]

  indexes {
    (sku_id, option_group_id) [pk]
    option_value_id [name: 'ix_sku_option_value']
  }
}

Table sku_package [note: '포장 박스 (가구는 SKU 1개가 여러 박스로 출고됨: 침대 = 헤드보드 + 프레임 + 갈빗살). 화물 운임과 배송 차량 판단 근거'] {
  sku_id bigint [not null]
  box_no tinyint [not null, note: '1부터. 박스 수 = 행 수']
  width_mm int [not null]
  depth_mm int [not null]
  height_mm int [not null]
  weight_kg decimal(6,1) [not null]
  contents varchar(100) [note: '박스 내용물 (헤드보드, 측판...)']

  indexes {
    (sku_id, box_no) [pk]
  }
}

Table product_image [note: '상품 이미지 (공통 + 옵션 값별)'] {
  image_id bigint [pk, increment]
  product_id bigint [not null]
  option_value_id bigint [note: 'NULL이면 공통 이미지. 색상을 고르면 해당 이미지로 교체']
  image_type varchar(20) [not null, note: 'THUMBNAIL/MAIN/DETAIL/SIZE_GUIDE(치수도)']
  image_url varchar(500) [not null]
  sort_order smallint [not null]

  indexes {
    (product_id, option_value_id) [name: 'ix_product_image_product']
    option_value_id [name: 'ix_product_image_option']
  }
}

Table product_qna [note: '상품 문의 (구매 전에도 작성 가능)'] {
  qna_id bigint [pk, increment]
  product_id bigint [not null]
  sku_id bigint [note: '특정 옵션에 대한 문의면 지정']
  member_id bigint [not null]
  qna_type varchar(20) [not null, note: 'PRODUCT/SIZE/SHIPPING/INSTALL/RETURN/ETC']
  content varchar(2000) [not null]
  is_secret char(1) [not null, default: 'N', note: '비밀글이면 작성자와 관리자만 열람']
  answer_content varchar(2000)
  answered_by bigint [note: '답변 관리자']
  answered_at datetime
  status varchar(20) [not null, default: 'WAITING', note: 'WAITING/ANSWERED/HIDDEN']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime

  indexes {
    (product_id, created_at) [name: 'ix_product_qna_product']
    (status, created_at) [name: 'ix_product_qna_status', note: '미답변 문의 목록']
    member_id [name: 'ix_product_qna_member']
    sku_id [name: 'ix_product_qna_sku']
    answered_by [name: 'ix_product_qna_answered_by']
  }
}

// =====================================================================
// 2단계: 상품 - 연결 / 이력
// =====================================================================

Table product_style [note: '상품 인테리어 스타일 태그 (1단계 style 재사용)'] {
  product_id bigint [not null]
  style_id bigint [not null]

  indexes {
    (product_id, style_id) [pk]
    style_id [name: 'ix_product_style_style']
  }
}

Table member_brand_preference [note: '회원 선호(팔로우) 브랜드'] {
  member_id bigint [not null]
  brand_id bigint [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (member_id, brand_id) [pk]
    brand_id [name: 'ix_mbp_brand']
  }
}

Table stock_history [note: '재고 원장. SKU.stock 변경과 같은 트랜잭션에서 기록'] {
  stock_history_id bigint [pk, increment]
  sku_id bigint [not null]
  change_type varchar(20) [not null, note: 'INBOUND/ORDER/CANCEL/RETURN/EXCHANGE/ADJUST']
  quantity int [not null, note: '+입고 / -출고']
  stock_after int [not null, note: '변경 후 재고']
  ref_type varchar(20) [note: 'ORDER/CLAIM']
  ref_id bigint [note: '주문/클레임 ID (다음 단계 테이블)']
  memo varchar(500)
  created_by bigint [note: '관리자. 시스템 처리는 NULL']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (sku_id, created_at) [name: 'ix_stock_history_sku']
    created_by [name: 'ix_stock_history_created_by']
  }
}

Table price_history [note: '가격 변경 이력 (가격 인하 알림 근거)'] {
  price_history_id bigint [pk, increment]
  product_id bigint [not null]
  list_price bigint [not null]
  sale_price bigint [not null]
  changed_by bigint [not null, note: '관리자']
  changed_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (product_id, changed_at) [name: 'ix_price_history_product']
    changed_by [name: 'ix_price_history_changed_by']
  }
}

Table restock_request [note: '재입고 알림 신청 (SKU 단위). 재고가 0 → 양수가 되면 WAITING 신청자에게 발송'] {
  request_id bigint [pk, increment]
  member_id bigint [not null]
  sku_id bigint [not null]
  status varchar(20) [not null, default: 'WAITING', note: 'WAITING/NOTIFIED/CANCELED. 알림 후 다시 신청하면 같은 행을 WAITING으로 되돌림']
  requested_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  notified_at datetime

  indexes {
    (member_id, sku_id) [unique, name: 'uk_restock_request']
    (sku_id, status) [name: 'ix_restock_request_sku', note: '재입고 시 발송 대상 조회']
  }
}

// =====================================================================
// 2단계: 상품 - 검색 / 필터
// =====================================================================

Table color_family [note: '컬러 계열 마스터. 상품 필터 칩으로 노출'] {
  color_family_id bigint [pk, increment]
  family_code varchar(20) [not null, unique, note: 'WHITE/IVORY/BEIGE/BROWN/NATURAL_WOOD/GRAY/BLACK/NAVY/GREEN/PINK/MULTI']
  name_ko varchar(30) [not null]
  represent_hex char(7) [not null, note: '필터 칩 표시 색']
  sort_order smallint [not null]
}

Table material [note: '소재 마스터'] {
  material_id bigint [pk, increment]
  material_code varchar(20) [not null, unique, note: 'SOLID_WOOD(원목)/MDF/PB/STEEL/GLASS/MARBLE/FABRIC/LEATHER/RATTAN/PLASTIC...']
  name_ko varchar(30) [not null]
  sort_order smallint [not null]
}

Table product_material [note: '상품 소재 (필터용). 법정 표기 문구는 product_notice.material'] {
  product_id bigint [not null]
  material_id bigint [not null]
  part varchar(20) [not null, default: 'MAIN', note: 'MAIN/FRAME/TOP(상판)/LEG(다리)/UPHOLSTERY(커버)']

  indexes {
    (product_id, material_id, part) [pk]
    material_id [name: 'ix_product_material_filter']
  }
}

Table attribute [note: '카테고리별 필터 속성 (침대 사이즈, 소파 인원, 수납 여부, 전구 색온도...)'] {
  attribute_id bigint [pk, increment]
  category_id bigint [note: '적용 카테고리 (하위 카테고리 포함). NULL이면 전체']
  attribute_code varchar(30) [not null, unique, note: 'BED_SIZE/SOFA_SEATS/HAS_STORAGE/LIGHT_COLOR_TEMP...']
  name_ko varchar(30) [not null]
  is_filterable char(1) [not null, default: 'Y', note: '검색 필터 노출 여부']
  is_multi_select char(1) [not null, default: 'N', note: '상품 하나에 값 여러 개 허용 여부']
  sort_order smallint [not null]

  indexes {
    category_id [name: 'ix_attribute_category']
  }
}

Table attribute_value [note: '속성 값 (침대 사이즈 → SS/Q/K/LK)'] {
  value_id bigint [pk, increment]
  attribute_id bigint [not null]
  value_code varchar(30) [not null]
  name_ko varchar(30) [not null]
  sort_order smallint [not null]

  indexes {
    (attribute_id, value_code) [unique, name: 'uk_attribute_value']
  }
}

Table product_attribute_value [note: '상품별 속성 값'] {
  product_id bigint [not null]
  value_id bigint [not null]

  indexes {
    (product_id, value_id) [pk]
    value_id [name: 'ix_pav_value', note: '속성 값으로 상품 찾기']
  }
}

Table search_synonym [note: '검색 동의어 (쇼파 → 소파, 행거 → 옷걸이, 러그 → 카페트). 스토어와 커뮤니티 검색 공용'] {
  synonym_id bigint [pk, increment]
  term varchar(50) [not null, unique, note: '사용자가 입력하는 단어']
  standard_term varchar(50) [not null, note: '표준 검색어']
  is_active char(1) [not null, default: 'Y']
  created_by bigint [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    created_by [name: 'ix_search_synonym_created_by']
  }
}

// =====================================================================
// 2단계: 상품 - 가구 배송 (권역별 배송 가능 여부·추가비)
// =====================================================================

Table delivery_zone [note: '배송 권역. 설치배송 가능 지역과 추가 배송비를 판단하는 단위'] {
  zone_id bigint [pk, increment]
  zone_code varchar(20) [not null, unique, note: 'METRO(수도권)/CHUNGCHEONG/GANGWON/HONAM/YEONGNAM/JEJU/ISLAND(도서산간)']
  name_ko varchar(30) [not null]
  sort_order smallint [not null]
}

Table delivery_zone_zipcode [note: '우편번호 범위 → 권역. 배송지 zipcode로 권역을 찾는다'] {
  range_id bigint [pk, increment]
  zone_id bigint [not null]
  zip_from char(5) [not null]
  zip_to char(5) [not null, note: 'CHECK zip_from <= zip_to. 범위가 겹치면 더 좁은 범위(도서산간)를 우선 적용']

  indexes {
    (zip_from, zip_to) [name: 'ix_zone_zipcode_range']
    zone_id [name: 'ix_zone_zipcode_zone']
  }
}

Table shipping_policy_zone [note: '배송 정책별 권역 설정. 행이 없는 권역은 기본 배송비로 배송'] {
  policy_id bigint [not null]
  zone_id bigint [not null]
  is_available char(1) [not null, default: 'Y', note: 'N이면 배송 불가 (예: 설치배송은 제주·도서산간 불가)']
  extra_fee bigint [not null, default: 0, note: '권역 추가 배송비']
  extra_lead_days smallint [not null, default: 0, note: '권역 추가 소요일']

  indexes {
    (policy_id, zone_id) [pk]
    zone_id [name: 'ix_policy_zone_zone']
  }
}

// =====================================================================
// 2단계: 상품 - 구성
// =====================================================================

Table product_relation [note: '연관 상품'] {
  product_id bigint [not null]
  related_product_id bigint [not null, note: 'CHECK product_id <> related_product_id']
  relation_type varchar(20) [not null, note: 'SAME_SERIES(같은 시리즈)/ADDON(추가 구매: 침대 → 매트리스)/SIMILAR(비슷한 상품)']
  sort_order smallint [not null]
  created_by bigint [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (product_id, relation_type, related_product_id) [pk]
    related_product_id [name: 'ix_product_relation_related']
    created_by [name: 'ix_product_relation_created_by']
  }
}

Table product_set_item [note: '세트 상품 구성품 (식탁 세트 = 식탁 1 + 의자 4). 세트는 자체 SKU 없이 구성품 SKU를 각각 선택'] {
  set_product_id bigint [not null, note: 'product_type = SET인 상품']
  component_product_id bigint [not null, note: 'product_type = SINGLE인 상품']
  quantity smallint [not null, default: 1]
  sort_order smallint [not null]

  indexes {
    (set_product_id, component_product_id) [pk]
    component_product_id [name: 'ix_product_set_item_component']
  }
}

Table product_status_history [note: '상품 상태 변경 이력 (판매중지 사유 추적)'] {
  history_id bigint [pk, increment]
  product_id bigint [not null]
  from_status varchar(20) [note: '최초 등록은 NULL']
  to_status varchar(20) [not null]
  reason varchar(500)
  changed_by bigint [note: '관리자. 자동 품절 처리 등 시스템 변경은 NULL']
  changed_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (product_id, changed_at) [name: 'ix_psh_product']
    changed_by [name: 'ix_psh_changed_by']
  }
}

// =====================================================================
// 3단계: 커뮤니티 - 글 (구매 고객 콘텐츠 + 브랜드 매거진)
// =====================================================================

Table post [note: '커뮤니티 글 공통. 유형별 추가 정보는 *_detail 테이블 (슈퍼타입/서브타입). 자사몰 규모에 맞춰 고객 사진·집들이와 운영자 매거진만 운영'] {
  post_id bigint [pk, increment]
  member_id bigint [not null, note: '작성자. MAGAZINE은 role이 EDITOR/ADMIN인 회원만 (앱 검증)']
  post_type varchar(20) [not null, note: 'PHOTO(집사진)/HOUSEWARMING(집들이)/MAGAZINE(브랜드 매거진)']
  title varchar(200) [note: 'PHOTO는 NULL 허용, 나머지는 필수 (CHECK)']
  cover_image_id bigint [note: '목록 썸네일로 쓸 이미지']
  status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT(임시저장)/PUBLISHED/HIDDEN(작성자 숨김)/BLINDED(신고 누적·관리자 블라인드)/DELETED']
  published_at datetime [note: '최초 발행 시각. 피드 정렬 기준']
  is_featured char(1) [not null, default: 'N', note: '에디터 추천 (메인 노출)']
  featured_at datetime
  allow_comment char(1) [not null, default: 'Y']
  view_count int [not null, default: 0, note: '캐시']
  like_count int [not null, default: 0, note: '캐시']
  scrap_count int [not null, default: 0, note: '캐시']
  comment_count int [not null, default: 0, note: '캐시']
  report_count int [not null, default: 0, note: '캐시. 기준 이상이면 자동 BLINDED']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime
  deleted_at datetime

  indexes {
    (post_type, status, published_at) [name: 'ix_post_feed', note: '유형별 최신 피드']
    (post_type, status, like_count) [name: 'ix_post_popular', note: '인기순']
    (member_id, status, created_at) [name: 'ix_post_member', note: '내 글 / 프로필']
    (is_featured, featured_at) [name: 'ix_post_featured']
    cover_image_id [name: 'ix_post_cover_image']
  }
}

Table post_image [note: '글에 올린 사진. 상품 태그의 기준'] {
  image_id bigint [pk, increment]
  post_id bigint [not null]
  image_url varchar(500) [not null]
  width_px int [not null, note: '피드 레이아웃(메이슨리)용 원본 크기']
  height_px int [not null]
  space_type varchar(20) [note: 'LIVING/BEDROOM/KITCHEN/BATHROOM/KIDS/DRESSROOM/STUDY/ENTRANCE/BALCONY/ETC. 공간별 사진 필터']
  caption varchar(1000) [note: 'PHOTO 글은 사진마다 설명']
  sort_order smallint [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (post_id, sort_order) [unique, name: 'uk_post_image_order']
    (space_type, post_id) [name: 'ix_post_image_space']
  }
}

Table post_block [note: '본문 블록 (집들이/매거진 같은 긴 글 에디터). 글 = 블록을 sort_order 순서로 이어 붙인 것'] {
  block_id bigint [pk, increment]
  post_id bigint [not null]
  sort_order smallint [not null]
  block_type varchar(20) [not null, note: 'HEADING/TEXT/IMAGE/QUOTE/DIVIDER/PRODUCT(상품 카드)']
  text_content text [note: 'HEADING/TEXT/QUOTE 본문']
  image_id bigint [note: 'IMAGE 블록이면 post_image']
  product_id bigint [note: 'product 블록이면 상품. CHECK 유형별 필수 컬럼']

  indexes {
    (post_id, sort_order) [unique, name: 'uk_post_block_order']
    image_id [name: 'ix_post_block_image']
    product_id [name: 'ix_post_block_product']
  }
}

Table post_product_tag [note: '사진 위 상품 태그 (사진 속 가구를 눌러 바로 구매). 오늘의집 핵심 기능'] {
  tag_id bigint [pk, increment]
  image_id bigint [not null]
  product_id bigint [note: '스토어 상품. 판매하지 않는 제품이면 NULL']
  external_name varchar(200) [note: '스토어에 없는 제품 직접 입력 (예: 이케아 빌리 책장). CHECK product_id 또는 external_name 중 하나 필수']
  pos_x decimal(5,2) [not null, note: '사진 가로 위치 % (0~100). 해상도와 무관']
  pos_y decimal(5,2) [not null, note: '사진 세로 위치 % (0~100)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    image_id [name: 'ix_ppt_image']
    product_id [name: 'ix_ppt_product', note: '상품 상세의 "이 상품이 쓰인 사진"']
  }
}

Table housewarming_detail [note: '집들이 상세 (post와 1:1). 목록 필터 조건'] {
  post_id bigint [pk, note: 'post_type = HOUSEWARMING']
  housing_type varchar(20) [not null, note: 'APARTMENT/VILLA/HOUSE/OFFICETEL/ONE_ROOM/ETC']
  area_pyeong smallint [not null]
  room_count tinyint
  family_type varchar(20) [note: 'SINGLE/COUPLE/WITH_KIDS/WITH_PARENTS/SHARE/ETC']
  region varchar(30) [note: '시/도 단위까지만 (개인정보 보호)']
  work_type varchar(20) [not null, note: 'SELF(셀프)/PARTIAL(부분 시공)/PRO(전문가 시공)']
  work_scope varchar(200) [note: '도배, 바닥, 조명, 욕실 리모델링 등']
  work_period_weeks smallint
  budget_manwon int [note: '예산 (만원)']
  has_pet char(1) [note: 'Y/N']

  indexes {
    (housing_type, area_pyeong) [name: 'ix_hw_housing_area']
    (work_type, budget_manwon) [name: 'ix_hw_work_budget']
  }
}

Table magazine_detail [note: '브랜드 매거진 상세 (post와 1:1). 운영자가 쓰는 인테리어 가이드·신상품 소개'] {
  post_id bigint [pk, note: 'post_type = MAGAZINE']
  topic varchar(20) [not null, note: 'STYLING(스타일링)/GUIDE(구매 가이드)/CARE(관리법)/NEW_ARRIVAL(신상품)/TREND/DIY']
  subtitle varchar(200)
  reading_min smallint [note: '읽는 시간 (분)']

  indexes {
    topic [name: 'ix_magazine_topic']
  }
}

// =====================================================================
// 3단계: 커뮤니티 - 분류 / 반응
// =====================================================================

Table post_style [note: '글의 인테리어 스타일 (1단계 style 재사용 → 같은 기준으로 글과 상품 추천)'] {
  post_id bigint [not null]
  style_id bigint [not null]

  indexes {
    (post_id, style_id) [pk]
    style_id [name: 'ix_post_style_style']
  }
}

Table post_comment [note: '댓글 + 대댓글 (1단계 깊이)'] {
  comment_id bigint [pk, increment]
  post_id bigint [not null]
  member_id bigint [not null]
  parent_id bigint [note: '대댓글이면 원댓글. 대댓글의 대댓글은 원댓글에 붙임']
  mention_member_id bigint [note: '@닉네임 멘션 대상']
  content varchar(1000) [not null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE/DELETED/BLINDED. 대댓글이 있으면 "삭제된 댓글입니다"로 표시']
  report_count int [not null, default: 0, note: '캐시']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime

  indexes {
    (post_id, parent_id, created_at) [name: 'ix_comment_post']
    (member_id, created_at) [name: 'ix_comment_member']
    parent_id [name: 'ix_comment_parent']
    mention_member_id [name: 'ix_comment_mention']
  }
}

Table post_like [note: '글 좋아요'] {
  member_id bigint [not null]
  post_id bigint [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (member_id, post_id) [pk]
    post_id [name: 'ix_post_like_post']
  }
}

Table scrap [note: '스크랩 = 글 저장 + 상품 찜. 대상은 post 또는 product 중 하나 (CHECK)'] {
  scrap_id bigint [pk, increment]
  member_id bigint [not null]
  post_id bigint
  product_id bigint
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (member_id, post_id) [unique, name: 'uk_scrap_post', note: '같은 글 중복 스크랩 방지. MySQL UNIQUE는 NULL 행을 중복으로 보지 않아 상품 스크랩 행과 충돌하지 않음']
    (member_id, product_id) [unique, name: 'uk_scrap_product', note: '같은 상품 중복 찜 방지']
    (member_id, created_at) [name: 'ix_scrap_member', note: '내 스크랩 최신순']
    post_id [name: 'ix_scrap_post']
    product_id [name: 'ix_scrap_product']
  }
}

// =====================================================================
// 3단계: 커뮤니티 - 운영
// =====================================================================

Table report [note: '신고 (글/댓글/회원). 대상 컬럼 중 정확히 하나만 채움 (CHECK). 승인되면 회원 정지는 member_status_history로 기록'] {
  report_id bigint [pk, increment]
  reporter_id bigint [not null]
  post_id bigint
  comment_id bigint
  target_member_id bigint
  reason_type varchar(20) [not null, note: 'SPAM/ADVERTISING/ABUSE/ADULT/COPYRIGHT/PRIVACY/ETC']
  detail varchar(1000)
  status varchar(20) [not null, default: 'RECEIVED', note: 'RECEIVED/ACCEPTED/REJECTED']
  handled_by bigint [note: '처리 관리자']
  handled_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (reporter_id, post_id) [unique, name: 'uk_report_post', note: '같은 글 중복 신고 방지 (NULL 행은 중복 아님)']
    (reporter_id, comment_id) [unique, name: 'uk_report_comment']
    (status, created_at) [name: 'ix_report_queue', note: '처리 대기 목록']
    reporter_id [name: 'ix_report_reporter']
    post_id [name: 'ix_report_post']
    comment_id [name: 'ix_report_comment']
    target_member_id [name: 'ix_report_target_member']
    handled_by [name: 'ix_report_handled_by']
  }
}

Table notification [note: '알림함 (앱 내 알림 목록). 발송 여부는 member_notification_setting 기준'] {
  notification_id bigint [pk, increment]
  member_id bigint [not null, note: '받는 사람']
  actor_id bigint [note: '행동한 사람 (좋아요/댓글 단 회원). 시스템 알림은 NULL']
  noti_type varchar(20) [not null, note: 'COMMENT/REPLY/MENTION/LIKE/FEATURED(추천 선정)/RESTOCK/PRICE_DROP/ORDER/DELIVERY/NOTICE']
  post_id bigint
  comment_id bigint
  product_id bigint
  message varchar(300) [not null]
  link_url varchar(500)
  is_read char(1) [not null, default: 'N']
  read_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (member_id, is_read, created_at) [name: 'ix_notification_member', note: '안 읽은 알림 수, 최신순 목록']
    actor_id [name: 'ix_notification_actor']
    post_id [name: 'ix_notification_post']
    comment_id [name: 'ix_notification_comment']
    product_id [name: 'ix_notification_product']
  }
}

// =====================================================================
// 관계 (> 다대일, - 일대일)
// =====================================================================

// 고객
Ref: member_account.grade_id > member_grade.grade_id
Ref: member_account.referred_by > member_account.member_id
Ref: member_social.member_id > member_account.member_id
Ref: member_home.member_id - member_account.member_id
Ref: address.member_id > member_account.member_id
Ref: member_terms_agreement.member_id > member_account.member_id
Ref: member_terms_agreement.terms_id > terms.terms_id
Ref: member_notification_setting.member_id > member_account.member_id
Ref: member_style.member_id > member_account.member_id
Ref: member_style.style_id > style.style_id
Ref: login_history.member_id > member_account.member_id
Ref: member_token.member_id > member_account.member_id
Ref: member_session.member_id > member_account.member_id
Ref: password_history.member_id > member_account.member_id
Ref: privacy_access_log.admin_id > member_account.member_id
Ref: privacy_access_log.target_member_id > member_account.member_id
Ref: member_status_history.member_id > member_account.member_id
Ref: member_status_history.changed_by > member_account.member_id
Ref: member_status_history.report_id > report.report_id
Ref: nickname_history.member_id > member_account.member_id
Ref: forbidden_word.created_by > member_account.member_id

// 상품
Ref: category.parent_id > category.category_id
Ref: product.brand_id > brand.brand_id
Ref: product.category_id > category.category_id
Ref: product.shipping_policy_id > shipping_policy.policy_id
Ref: product_notice.product_id - product.product_id
Ref: product_option_group.product_id > product.product_id
Ref: product_option_value.option_group_id > product_option_group.option_group_id
Ref: product_option_value.color_family_id > color_family.color_family_id
Ref: product_sku.product_id > product.product_id
Ref: product_sku_option.sku_id > product_sku.sku_id
Ref: product_sku_option.option_group_id > product_option_group.option_group_id
Ref: product_sku_option.option_value_id > product_option_value.option_value_id
Ref: product_image.product_id > product.product_id
Ref: product_image.option_value_id > product_option_value.option_value_id
Ref: product_qna.product_id > product.product_id
Ref: product_qna.sku_id > product_sku.sku_id
Ref: product_qna.member_id > member_account.member_id
Ref: product_qna.answered_by > member_account.member_id
Ref: stock_history.sku_id > product_sku.sku_id
Ref: price_history.product_id > product.product_id
Ref: sku_package.sku_id > product_sku.sku_id

// 가구 배송
Ref: delivery_zone_zipcode.zone_id > delivery_zone.zone_id
Ref: shipping_policy_zone.policy_id > shipping_policy.policy_id
Ref: shipping_policy_zone.zone_id > delivery_zone.zone_id

// 고객 ↔ 상품
Ref: product_style.product_id > product.product_id
Ref: product_style.style_id > style.style_id
Ref: member_brand_preference.member_id > member_account.member_id
Ref: member_brand_preference.brand_id > brand.brand_id
Ref: product.created_by > member_account.member_id
Ref: product.updated_by > member_account.member_id
Ref: stock_history.created_by > member_account.member_id
Ref: price_history.changed_by > member_account.member_id
Ref: restock_request.member_id > member_account.member_id
Ref: restock_request.sku_id > product_sku.sku_id

// 상품 검색 / 필터
Ref: product_material.product_id > product.product_id
Ref: product_material.material_id > material.material_id
Ref: attribute.category_id > category.category_id
Ref: attribute_value.attribute_id > attribute.attribute_id
Ref: product_attribute_value.product_id > product.product_id
Ref: product_attribute_value.value_id > attribute_value.value_id
Ref: search_synonym.created_by > member_account.member_id

// 상품 구성
Ref: product_relation.product_id > product.product_id
Ref: product_relation.related_product_id > product.product_id
Ref: product_relation.created_by > member_account.member_id
Ref: product_set_item.set_product_id > product.product_id
Ref: product_set_item.component_product_id > product.product_id

// 상품 운영
Ref: product_status_history.product_id > product.product_id
Ref: product_status_history.changed_by > member_account.member_id

// 커뮤니티 - 글
Ref: post.member_id > member_account.member_id
Ref: post.cover_image_id > post_image.image_id
Ref: post_image.post_id > post.post_id
Ref: post_block.post_id > post.post_id
Ref: post_block.image_id > post_image.image_id
Ref: post_block.product_id > product.product_id
Ref: post_product_tag.image_id > post_image.image_id
Ref: post_product_tag.product_id > product.product_id
Ref: housewarming_detail.post_id - post.post_id
Ref: magazine_detail.post_id - post.post_id

// 커뮤니티 - 분류 / 반응
Ref: post_style.post_id > post.post_id
Ref: post_style.style_id > style.style_id
Ref: post_comment.post_id > post.post_id
Ref: post_comment.member_id > member_account.member_id
Ref: post_comment.parent_id > post_comment.comment_id
Ref: post_comment.mention_member_id > member_account.member_id
Ref: post_like.member_id > member_account.member_id
Ref: post_like.post_id > post.post_id
Ref: scrap.member_id > member_account.member_id
Ref: scrap.post_id > post.post_id
Ref: scrap.product_id > product.product_id

// 커뮤니티 - 운영
Ref: report.reporter_id > member_account.member_id
Ref: report.post_id > post.post_id
Ref: report.comment_id > post_comment.comment_id
Ref: report.target_member_id > member_account.member_id
Ref: report.handled_by > member_account.member_id
Ref: notification.member_id > member_account.member_id
Ref: notification.actor_id > member_account.member_id
Ref: notification.post_id > post.post_id
Ref: notification.comment_id > post_comment.comment_id
Ref: notification.product_id > product.product_id

// =====================================================================
// 화면 그룹 (dbdiagram에서 영역별로 묶여 보임)
// =====================================================================

TableGroup member_basic [note: '고객 - 회원 기본'] {
  member_grade
  member_account
  member_social
  member_home
  address
}

TableGroup member_terms_noti_style [note: '고객 - 약관/알림/취향'] {
  terms
  member_terms_agreement
  member_notification_setting
  style
  member_style
}

TableGroup member_security [note: '고객 - 보안'] {
  login_history
  member_token
  member_session
  password_history
  privacy_access_log
}

TableGroup member_lifecycle [note: '고객 - 상태/닉네임 정책'] {
  member_status_history
  nickname_history
  forbidden_word
}

TableGroup product_classification [note: '상품 - 분류/브랜드'] {
  brand
  category
}

TableGroup product_core [note: '상품 - 상품/옵션/SKU/문의'] {
  product
  product_notice
  product_option_group
  product_option_value
  product_sku
  product_sku_option
  product_image
  product_qna
}

TableGroup product_delivery [note: '상품 - 가구 배송/포장'] {
  shipping_policy
  delivery_zone
  delivery_zone_zipcode
  shipping_policy_zone
  sku_package
}

TableGroup product_link_history [note: '상품 - 연결/재고/알림'] {
  product_style
  member_brand_preference
  stock_history
  price_history
  restock_request
}

TableGroup product_search_filter [note: '상품 - 검색/필터'] {
  color_family
  material
  product_material
  attribute
  attribute_value
  product_attribute_value
  search_synonym
}

TableGroup product_composition_operation [note: '상품 - 구성/상태 이력'] {
  product_relation
