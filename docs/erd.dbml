// =====================================================================
// 패션 브랜드 입점형 쇼핑몰 DB 설계 (dbdiagram.io용 DBML)
// 벤치마킹: W컨셉 (디자이너 브랜드 입점, 의류·신발·가방·잡화)
// 진행 중: 고객 10개(회원 기본 7 + 회원 등급 3) + 브랜드 3개(브랜드 기본 1 + 배송 정책 2) + 상품 15개(상품 기본 7 + 기준 데이터 3 + 실측 3 + 정보 고시 1 + 고객 연결 1) + 주문 5개(장바구니 1 + 주문 기본 4) + 결제 6개(결제 기본 6) = 39개 테이블 (묶음 단위로 컬럼까지 확정하며 추가)
// 사용법: https://dbdiagram.io/d 에 접속 → 왼쪽 편집기에 이 파일 내용을 전체 붙여넣기
// DBMS: MySQL 8.0 (8.0.16 이상: CHECK 제약 적용, 8.0.13 이상: 함수 기반 인덱스)
// 이전 설계 보관: docs/archive_interior/ (인테리어몰), docs/archive_fashion/ (패션몰 Oracle), docs/archive_oracle/
// =====================================================================

Project fashion_mall {
  database_type: 'MySQL'
  Note: '''
  패션 브랜드 입점형 쇼핑몰 포트폴리오 DB (MySQL 8.0, InnoDB, utf8mb4 / utf8mb4_0900_ai_ci)
  - 여러 패션 브랜드가 입점해 의류·신발·가방·잡화를 판매 (W컨셉 벤치마킹)
  - 이름은 소문자 snake_case
  - AUTO_INCREMENT 쓰지 않음: 회원은 아이디(varchar)가 PK, 하위 테이블은 부모 키 + 번호/코드 복합키
  - 상태값은 VARCHAR + CHECK, Y/N은 CHAR(1) + CHECK
  - created_at DEFAULT CURRENT_TIMESTAMP, updated_at은 ON UPDATE CURRENT_TIMESTAMP
  - 탈퇴는 soft delete + 개인정보 마스킹
  '''
}

// =====================================================================
// 고객 - 회원 기본
// =====================================================================

Table member_account [note: '[회원] 구매 고객 계정. 브랜드 관리자·운영자 계정은 별도 테이블'] {
  member_id varchar(20) [pk, note: '[회원 아이디] 가입 시 직접 입력(소셜 가입도 한 번 정함). 영문 소문자로 시작, 영문 소문자·숫자 4~20자 (앱 검증). 변경 불가, 탈퇴 후에도 행이 남아 재사용 불가']
  password_hash varchar(255) [note: '[비밀번호(해시)] 회원 비밀번호. 평문은 어디에도 저장하지 않고(로그 포함) bcrypt 단방향 해시(일방향 암호화, 개인정보 안전성 확보조치 기준). 솔트는 해시 문자열에 포함되어 별도 컬럼 없음. 원래 값으로 복원 불가라 비밀번호 찾기는 재설정만. 소셜 전용 가입은 NULL']
  member_name varchar(50) [not null, note: '[회원 이름] 실명. 가입 시 휴대폰 본인인증 결과로 채움(직접 입력 아님). 탈퇴 시 탈퇴회원']
  nickname varchar(20) [not null, note: '[회원 닉네임] 리뷰·문의에 표시. 2~12자 한글/영문/숫자/_ (앱 검증). 탈퇴 시 deleted_{아이디}']
  email varchar(100) [not null, note: '[이메일] 회원 이메일. 평문 저장(법적 암호화 대상 아님, 암호화하면 UNIQUE·대소문자 무시 비교·아이디 찾기가 안 됨). 관리자 화면은 마스킹, 조회는 접근 기록. 대소문자 무시 콜레이션(utf8mb4_0900_ai_ci)이라 UNIQUE만으로 대소문자 중복 방지. 탈퇴 시 withdrawn_{아이디}@deleted.local로 마스킹']
  phone_enc varchar(255) [note: '[회원 휴대폰 번호(암호화)] 가입 시 휴대폰 본인인증 결과로 채움(활동 회원은 항상 값 있음, 앱 검증). 탈퇴 시 NULL. AES-256 암호문. 문자 발송·화면 표시처럼 실제 번호가 필요할 때 복호화. 같은 번호도 매번 다른 암호문(IV)이라 검색에는 phone_hash 사용. 법적 의무는 아니지만 유출 시 피해(스팸·피싱)가 커서 추가 보호']
  phone_hash char(64) [note: '[회원 휴대폰 번호 검색값] HMAC-SHA256(서버 비밀 키). 탈퇴 시 NULL. 같은 번호면 항상 같은 값이라 아이디 찾기·같은 번호 가입 확인에 검색용으로 사용. 번호는 경우의 수가 약 1억 개라 단순 SHA-256은 전부 대입해 풀리므로 키를 섞음']
  birth_date date [not null, note: '[회원 생년월일] 가입 시 휴대폰 본인인증 결과로 채움(직접 입력 아님). 만 14세 미만 가입 불가(앱 검증). 생일 쿠폰, 연령대 맞춤 추천 기본값']
  gender char(1) [not null, note: '[회원 성별] F/M. 가입 시 휴대폰 본인인증 결과로 채움(직접 입력 아님). 맞춤 추천 피드 기본값']
  profile_image_url varchar(500) [note: '[회원 프로필 사진 경로] 선택 입력. 리뷰·스타일 게시글에 표시. 탈퇴 시 NULL']
  profile_intro varchar(200) [note: '[회원 소개글] 선택 입력. 탈퇴 시 NULL']
  ci_hash char(64) [note: '[회원 중복 가입 확인값(CI)] 휴대폰 본인인증 시 본인확인기관이 주는 연계정보(CI, 같은 사람이면 어느 사이트든 같은 값)를 HMAC-SHA256(서버 비밀 키)으로 저장. 원래 값은 볼 일 없이 비교만 함. 같은 사람은 계정 1개만 허용(가입 혜택 반복 수령 방지). 탈퇴 시 member_withdrawal.ci_hash로 옮기고(30일 재가입 제한용) 여기는 NULL']
  join_method varchar(20) [not null, note: '[회원 가입 수단] EMAIL/KAKAO/NAVER/FACEBOOK/INSTAGRAM/GOOGLE/APPLE. 처음 가입한 방법 (이후 연동한 소셜 계정은 member_social_account)']
  join_channel varchar(20) [not null, note: '[회원 가입 경로] PC_WEB/MOBILE_WEB/APP_IOS/APP_ANDROID']
  verified_at datetime [not null, note: '[회원 본인인증일시] 가입 시 휴대폰 본인인증 필수. 재인증 시 갱신']
  grade_code varchar(20) [not null, default: 'GREEN', note: '[회원 등급 코드] 회원 현재 등급 코드. 매월 1일 배치로 갱신(member_grade_history에 이력). 신규 가입은 GREEN']
  status varchar(20) [not null, default: 'ACTIVE', note: '[상태] 회원 상태. ACTIVE/DORMANT/SUSPENDED/WITHDRAWN. 로그인 잠금은 상태가 아니라 member_login.locked_until로 판단']
  suspended_until datetime [note: '[정지 종료일시] 회원 이용 정지 기한(status = SUSPENDED). 지나면 배치로 ACTIVE']
  nickname_changed_at datetime [note: '[회원 닉네임 변경일시] 변경 후 30일간 재변경 불가']
  withdrawn_at datetime [note: '[회원 탈퇴일시] 탈퇴 시 행은 남기고(아이디 재사용 방지, 거래 기록 참조) 마스킹: 이름·닉네임·이메일 변경, 휴대폰·ci_hash·프로필 사진·소개글 NULL. 로그인 상태·소셜 계정·체형·배송지·환불 계좌 행은 삭제. 탈퇴 사유·의견은 member_withdrawal']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 회원 가입일시']
  updated_at datetime [note: '[수정일시] 회원 정보 수정일시. 회원이 정보를 바꿀 때만 갱신. 로그인할 때마다 바뀌는 값은 member_login에 두어 이 값이 로그인으로 바뀌지 않게 함']

  indexes {
    email [unique, name: 'uk_member_email']
    nickname [unique, name: 'uk_member_nickname']
    ci_hash [unique, name: 'uk_member_ci', note: '같은 사람(CI)은 계정 1개. NULL(탈퇴)은 중복 허용']
    phone_hash [name: 'ix_member_phone_hash', note: '휴대폰 번호로 아이디 찾기·가입 확인']
    grade_code [name: 'ix_member_grade_code', note: 'FK 인덱스, 등급별 회원 조회']
  }
}

Table member_login [note: '[회원 로그인 상태] member_account와 1:1, 가입 시 함께 생성, 탈퇴 시 삭제. 로그인할 때마다 바뀌는 값을 분리해 회원 정보 수정일시가 로그인으로 바뀌지 않게 하고, 회원 행 수정과의 잠금 경합을 줄임'] {
  member_id varchar(20) [pk, note: '[회원 아이디] 로그인 상태 회원 아이디. member_account와 1:1']
  last_login_at datetime [note: '[마지막 로그인일시] 회원 마지막 로그인일시. 휴면 전환 배치 기준. 가입 직후는 NULL']
  login_fail_count tinyint [not null, default: 0, note: '[연속 로그인 실패 횟수] 회원 연속 로그인 실패 횟수. 로그인 성공 시 0으로 초기화']
  locked_until datetime [note: '[로그인 잠금 해제일시] 회원 로그인 잠금 해제일시. 5회 연속 실패 시 30분 뒤 시각으로 설정. 지나면 자동 해제(배치 불필요)']
  dormant_notice_sent_at datetime [note: '[회원 휴면 예정 안내일시] 마지막 로그인 11개월 시점에 안내, 1년 미접속 시 DORMANT. 안내 중복 발송 방지(NULL인 회원만 발송)와 안내 후 30일 경과 확인에 사용. 다시 로그인하면 NULL로 초기화']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 로그인 상태 등록일시. 가입일시와 같음']
  updated_at datetime [note: '[수정일시] 로그인 상태 수정일시']

  indexes {
    last_login_at [name: 'ix_member_login_last', note: '휴면 안내·전환 대상 배치 조회 (member_account.status와 조인)']
  }
}

Table member_body [note: '[회원 체형] member_account와 1:1. 사이즈 추천, "나와 비슷한 체형" 리뷰 필터'] {
  member_id varchar(20) [pk, note: '[회원 아이디] 체형 정보 회원 아이디. member_account와 1:1']
  height_cm smallint [note: '[회원 키(cm)]']
  weight_kg smallint [note: '[회원 몸무게(kg)]']
  top_size varchar(10) [note: '[회원 평소 상의 사이즈] XS/S/M/L/XL/XXL/FREE']
  bottom_size varchar(10) [note: '[회원 평소 하의 사이즈] 허리 inch(25~36) 또는 XS~XXL']
  shoe_size_mm smallint [note: '[회원 평소 신발 사이즈(mm)] 220~300, 5 단위 (앱 검증)']
  is_review_public char(1) [not null, default: 'Y', note: '[체형 리뷰 공개 기본 여부] Y/N. 리뷰 작성 화면의 "체형 공개" 체크박스 기본값. 리뷰를 쓸 때 그 시점의 체형과 공개 여부를 리뷰에 복사해 저장(상품 단계 리뷰 테이블). 나중에 체형을 바꿔도 지난 리뷰의 체형은 그대로']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 회원 체형 등록일시. 처음 입력한 시각 (가입 후 나중에 입력 가능)']
  updated_at datetime [note: '[수정일시] 회원 체형 수정일시']
}

Table member_refund_account [note: '[회원 환불 계좌] member_account와 1:1. 무통장·가상계좌 결제 취소 시 환불받을 계좌'] {
  member_id varchar(20) [pk, note: '[회원 아이디] 환불 계좌 회원 아이디. member_account와 1:1']
  bank_code char(3) [not null, note: '[은행 코드] 환불 은행. 금융결제원 3자리 은행 코드 (예: 004 국민, 088 신한)']
  account_no_enc varchar(255) [not null, note: '[환불 계좌번호(암호화)] AES-256 암호문. 계좌번호는 법정 암호화 대상. 화면에는 뒤 4자리만 표시']
  account_holder varchar(50) [not null, note: '[환불 계좌 예금주]']
  holder_verified_at datetime [note: '[환불 계좌 예금주 확인일시] 예금주 조회 API로 확인. NULL이면 미확인(환불 전 확인)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 환불 계좌 등록일시']
  updated_at datetime [note: '[수정일시] 환불 계좌 수정일시']
}

Table member_withdrawal [note: '[회원 탈퇴 정보] member_account와 1:1. 탈퇴한 회원만 행이 생김(아이디 재사용 불가라 회원당 최대 1번). 탈퇴 상태·일시는 member_account'] {
  member_id varchar(20) [pk, note: '[회원 아이디] 탈퇴 회원 아이디. member_account와 1:1']
  withdraw_reason_type varchar(20) [not null, note: '[탈퇴 사유 유형] 탈퇴 화면의 보기 중 하나를 고른 값(필수). LOW_USAGE/NO_PRODUCT/PRICE/DELIVERY/SERVICE/PRIVACY/REJOIN/ETC (이용 빈도 낮음/원하는 상품 없음/가격/배송/서비스 불만/개인정보 우려/재가입/기타). 사유별 통계']
  withdraw_free_text varchar(500) [note: '[탈퇴 시 직접 쓴 의견] 탈퇴 화면의 입력칸에 회원이 자유롭게 쓴 글(선택). 사유 선택 항목을 보충하는 서비스 개선용. 개인정보가 섞일 수 있어 탈퇴 1년 후 NULL(배치)']
  ci_hash char(64) [note: '[회원 중복 가입 확인값(CI)] 재가입 제한 확인값. 탈퇴 시 member_account.ci_hash를 옮겨 둠. 약관에 명시한 탈퇴 후 30일 재가입 제한(신규 가입 혜택 반복 수령 방지) 확인용. 30일 지나면 NULL(배치)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 회원 탈퇴 신청일시']
  updated_at datetime [note: '[수정일시] 회원 탈퇴 정보 수정일시. 직접 쓴 의견 NULL 처리 배치 등']

  indexes {
    withdraw_reason_type [name: 'ix_member_withdrawal_reason', note: '탈퇴 사유별 집계']
    ci_hash [name: 'ix_member_withdrawal_ci', note: '가입 시 30일 내 탈퇴 이력 확인']
  }
}

Table member_social_account [note: '[소셜 계정 연동] 한 회원이 여러 소셜 계정을 연결 가능 (제공자별 1개). 연동 해제·탈퇴 시 제공자 연동 해제 API 호출 후 행 삭제. 비밀번호 없는 소셜 전용 회원은 마지막 남은 소셜 계정을 해제할 수 없음(앱 검증, 로그인 수단이 사라지므로)'] {
  member_id varchar(20) [not null, note: '[회원 아이디] 소셜 연동 회원 아이디']
  provider varchar(20) [not null, note: '[소셜 제공자] KAKAO/NAVER/FACEBOOK/INSTAGRAM/GOOGLE/APPLE. 회원당 제공자별 1개라 (회원 아이디, 제공자)를 PK로 사용']
  provider_user_id varchar(100) [not null, note: '[소셜 제공자 회원 식별값] 소셜 서비스의 회원 고유 ID']
  provider_email varchar(100) [note: '[소셜 계정 이메일] 제공자가 준 이메일 (참고용, 로그인 이메일과 다를 수 있음). 소셜 로그인 시 바뀌었으면 갱신']
  refresh_token_enc varchar(1000) [note: '[소셜 연동 해제용 토큰(암호화)] 제공자가 준 리프레시 토큰의 AES-256 암호문. 연동 해제·탈퇴 시 해제(revoke) API에 사용(애플은 탈퇴 시 해제 의무, 네이버도 토큰 필요). 카카오는 서버 키로 해제 가능해 NULL 허용. 액세스 토큰은 금방 만료되어 저장 안 함']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 소셜 계정 연동일시']
  updated_at datetime [note: '[수정일시] 소셜 계정 정보 수정일시']

  indexes {
    (provider, provider_user_id) [unique, name: 'uk_member_social_account_provider', note: '같은 소셜 계정은 한 회원에게만']
    (member_id, provider) [pk, note: '회원당 제공자별 1개. member_id 선두라 FK 인덱스 겸용']
  }
}

Table member_address [note: '[배송지] 회원당 여러 개(최대 20개, 앱 검증: 추가 전 그 회원의 배송지 수 확인), 기본 배송지는 1개'] {
  member_id varchar(20) [not null, note: '[회원 아이디] 배송지 소유 회원 아이디']
  address_no smallint [not null, note: '[배송지 번호] 회원별 1부터. 앱이 그 회원의 MAX+1로 부여 (AUTO_INCREMENT 아님)']
  address_name varchar(20) [note: '[배송지 이름] 집/회사']
  recipient_name varchar(50) [not null, note: '[배송지 받는 분 이름]']
  recipient_phone_enc varchar(255) [not null, note: '[배송지 받는 분 연락처(암호화)] AES-256 암호문']
  zipcode char(5) [not null, note: '[배송지 우편번호] 5자리 국가기초구역번호']
  address1 varchar(200) [not null, note: '[배송지 기본 주소] 도로명 주소']
  address2 varchar(200) [note: '[배송지 상세 주소]']
  is_default char(1) [not null, default: 'N', note: '[기본 배송지 여부] Y/N']
  delivery_request varchar(100) [note: '[배송지 배송 요청사항] 예: 부재 시 문 앞. 주문 시 기본값으로 복사']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 배송지 등록일시']
  updated_at datetime [note: '[수정일시] 배송지 수정일시']

  indexes {
    (member_id, address_no) [pk, note: 'member_id 선두라 FK 인덱스 겸용']
    `CASE WHEN is_default = 'Y' THEN member_id END` [unique, name: 'ux_member_address_default', note: '회원당 기본 배송지 1개. MySQL 8.0.13+ 함수 기반 인덱스 (NULL은 중복 허용)']
  }
}

// =====================================================================
// 고객 - 회원 등급 (W컨셉 등급 체계 벤치마킹, 이름은 자체: GREEN/BLUE/GOLD/BLACK)
// =====================================================================

Table member_grade [note: '[회원 등급] 등급 기준표. GREEN(0점~)/BLUE(20만~)/GOLD(60만~)/BLACK(150만~). 회원등급점수 = 최근 6개월 배송완료 금액 + 활동포인트, 매월 1일 재산정. 관리자가 수정하는 기준 데이터'] {
  grade_code varchar(20) [pk, note: '[회원 등급 코드] GREEN/BLUE/GOLD/BLACK. 화면 이름이 바뀌어도(리브랜딩) 코드는 유지']
  grade_name varchar(30) [not null, note: '[회원 등급 이름] 화면 표시 이름']
  grade_level tinyint [not null, note: '[회원 등급 순서] 1(GREEN)~4(BLACK). 클수록 높은 등급']
  min_score bigint [not null, note: '[회원 등급 최소 점수] 이 점수 이상이면 이 등급 (0/200000/600000/1500000). 상한은 다음 등급의 최소 점수라 별도 컬럼 없음']
  point_rate decimal(4,2) [not null, note: '[회원 등급 구매 적립률(%)] 0.50/1.00/1.50/2.00']
  slogan varchar(100) [note: '[회원 등급 소개 문구] 등급 안내 화면 표시. 예: 처음 발견한 나만의 컨셉']
  is_active char(1) [not null, default: 'Y', note: '[사용 여부] 회원 등급 사용 여부. Y/N']
  created_by varchar(20) [note: '[등록 관리자] 회원 등급 등록 관리자 (운영자 테이블을 만들 때 FK 연결)']
  updated_by varchar(20) [note: '[수정 관리자] 회원 등급 수정 관리자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 회원 등급 등록일시']
  updated_at datetime [note: '[수정일시] 회원 등급 수정일시']

  indexes {
    grade_level [unique, name: 'uk_member_grade_level', note: '등급 순서 중복 방지']
    min_score [unique, name: 'uk_member_grade_min_score', note: '같은 최소 점수의 등급 2개 방지']
  }
}

Table member_grade_benefit [note: '[회원 등급 혜택] 등급 안내 화면에 보여 주는 등급별 혜택 목록. 혜택 종류가 많고 자주 바뀌어 Y/N 컬럼 대신 행으로 관리. 실제 쿠폰 지급은 혜택 단계의 쿠폰 테이블과 연결'] {
  grade_code varchar(20) [not null, note: '[회원 등급 코드] 혜택 대상 회원 등급 코드']
  benefit_no smallint [not null, note: '[회원 등급 혜택 번호] 등급별 1부터. 앱이 그 등급의 MAX+1로 부여']
  benefit_type varchar(20) [not null, note: '[혜택 유형] 회원 등급 혜택 유형. COUPON/POINT/EXCHANGE/PARTNER/CS/EVENT (쿠폰/포인트/무료 교환/제휴/전담 고객센터/이벤트)']
  title varchar(100) [not null, note: '[회원 등급 혜택 제목] 예: 15% 쿠폰 2장, 주문 상품당 1회 무료 교환, 폴인 3개월 구독권']
  description varchar(500) [note: '[설명] 회원 등급 혜택 설명']
  sort_order smallint [not null, default: 0, note: '[회원 등급 혜택 표시 순서]']
  is_active char(1) [not null, default: 'Y', note: '[사용 여부] 회원 등급 혜택 사용 여부. Y/N']
  created_by varchar(20) [note: '[등록 관리자] 회원 등급 혜택 등록 관리자']
  updated_by varchar(20) [note: '[수정 관리자] 회원 등급 혜택 수정 관리자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 회원 등급 혜택 등록일시']
  updated_at datetime [note: '[수정일시] 회원 등급 혜택 수정일시']

  indexes {
    (grade_code, benefit_no) [pk, note: 'grade_code 선두라 FK 인덱스 겸용']
  }
}

Table member_grade_history [note: '[회원 등급 이력] 등급이 정해질 때마다 1행 (가입, 매월 1일 산정, 예외 승급, 관리자 조정). 산정 당시 점수를 남겨 "○점 더 모으면 다음 등급" 표시와 등급 문의 대응에 사용'] {
  member_id varchar(20) [not null, note: '[회원 아이디] 등급 이력 회원 아이디']
  history_no int [not null, note: '[이력 번호] 회원 등급 이력 번호. 회원별 1부터. 앱이 그 회원의 MAX+1로 부여']
  prev_grade_code varchar(20) [note: '[이전 회원 등급 코드] 가입 시 NULL']
  grade_code varchar(20) [not null, note: '[회원 등급 코드] 적용 회원 등급 코드']
  change_type varchar(20) [not null, note: '[변경 유형] 회원 등급 변경 유형. JOIN/MONTHLY/PROMOTION/ADMIN (가입/월 산정/예외 승급: 제휴 카드 결제 등/관리자 조정). 종류별 집계용 코드']
  reason varchar(200) [note: '[변경 사유] 회원 등급 변경 사유. 변경 유형을 보충하는 자유 입력 문장. PROMOTION·ADMIN이면 필수(앱 검증). 예: VOC 보상으로 GOLD 유지']
  purchase_score bigint [not null, default: 0, note: '[회원 구매 금액 점수] 산정 기간의 배송완료 금액 (주문 단계에서 원천 연결)']
  activity_score bigint [not null, default: 0, note: '[회원 활동포인트 점수] 산정 기간의 활동포인트 (포인트 단계에서 원천 연결)']
  total_score bigint [not null, default: 0, note: '[회원 등급 점수 합계] 구매 금액 점수 + 활동포인트 점수']
  score_from date [note: '[등급 점수 산정 시작일] 월 산정이면 6개월 전 1일. 가입·관리자 조정은 NULL']
  score_to date [note: '[등급 점수 산정 종료일] 월 산정이면 전월 말일']
  applied_at datetime [not null, note: '[회원 등급 적용일시] 월 산정은 매월 1일 0시']
  created_by varchar(20) [note: '[등록 관리자] 이력을 남긴 관리자(ADMIN 조정 등). 월 산정·가입 같은 시스템 변경이면 NULL. 이력은 수정하지 않아 updated_by 없음']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 회원 등급 이력 등록일시']
  updated_at datetime [note: '[수정일시] 회원 등급 이력 수정일시']

  indexes {
    (member_id, history_no) [pk, note: 'member_id 선두라 FK 인덱스 겸용']
    grade_code [name: 'ix_member_grade_history_grade', note: 'FK 인덱스, 등급별 집계']
    prev_grade_code [name: 'ix_member_grade_history_prev', note: 'FK 인덱스']
    applied_at [name: 'ix_member_grade_history_applied', note: '월별 등급 변동 조회']
  }
}

// =====================================================================
// 브랜드 - 브랜드 기본 (상품 FK용으로 brand만 먼저. 사업자 정보·교환/반품 정책·브랜드 관리자·좋아요는 나중에, 배송비는 배송 정책 묶음)
// =====================================================================

Table brand [note: '[브랜드] 입점 브랜드. 상품은 한 브랜드에 속한다(W컨셉 → 브랜드 → 브랜드별 상품)'] {
  brand_id varchar(30) [pk, note: '[브랜드 아이디] 영문 소문자·숫자·하이픈. 입점 시 정함, 변경·재사용 불가. 브랜드관 URL에 사용(예: /brand/ourselves)']
  brand_name_ko varchar(100) [not null, note: '[브랜드 한글명] 브랜드 한글 이름']
  brand_name_en varchar(100) [not null, note: '[브랜드 영문명] 화면 대표 표기, 브랜드 목록 A~Z 정렬']
  brand_type varchar(20) [not null, note: '[브랜드 유형] DESIGNER/OWN/IMPORT (입점 디자이너/자체/수입)']
  logo_url varchar(500) [note: '[로고 이미지] 브랜드 로고 이미지 URL']
  description varchar(1000) [note: '[소개] 브랜드관 소개 문구']
  status varchar(20) [not null, default: 'ACTIVE', note: '[상태] 브랜드 입점 상태. ACTIVE/PAUSED/CLOSED (판매중/일시 중지/퇴점). PAUSED·CLOSED면 상품을 노출하지 않음']
  closed_at datetime [note: '[퇴점일시] status = CLOSED 처리 시각']
  like_count int [not null, default: 0, note: '[좋아요 수] 캐시. 원본(brand_like)은 브랜드 묶음에서 추가']
  created_by varchar(20) [note: '[등록 관리자] 브랜드 등록 관리자 (운영자 테이블을 만들 때 FK 연결)']
  updated_by varchar(20) [note: '[수정 관리자] 브랜드 수정 관리자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 브랜드 입점일시']
  updated_at datetime [note: '[수정일시] 브랜드 수정일시']

  indexes {
    brand_name_en [unique, name: 'uk_brand_name_en']
    status [name: 'ix_brand_status', note: '노출 브랜드 조회']
  }
}

// =====================================================================
// 브랜드 - 배송 정책 (브랜드당 정책 1개 + 플랫폼 공통 제주·도서산간 우편번호. 주문 때 계산한 결과는 주문 브랜드에 고정)
// =====================================================================

Table brand_shipping_policy [note: '[브랜드 배송 정책] brand 1:1, 브랜드 입점 시 함께 생성(앱). 브랜드 배송비 = 기본 배송비(이 브랜드 상품 금액 합계가 무료 배송 기준 이상이면 0) + 지역 추가 배송비(제주·도서산간, 무료 배송이어도 부과). 정책을 바꿔도 과거 주문은 그대로(계산 결과는 주문 브랜드에 고정). 교환·반품 배송비는 나중 묶음'] {
  brand_id varchar(30) [pk, note: '[브랜드 아이디] 정책의 브랜드']
  base_shipping_fee bigint [not null, default: 0, note: '[기본 배송비] 주문 안의 이 브랜드 묶음 1건당. 0이면 항상 무료. CHECK (base_shipping_fee >= 0)']
  free_shipping_min_amount bigint [note: '[무료 배송 기준 금액] 이 브랜드 상품 금액 합계가 이 금액 이상이면 기본 배송비 0. NULL이면 기준 없음. CHECK (free_shipping_min_amount IS NULL OR free_shipping_min_amount > 0)']
  jeju_extra_fee bigint [not null, default: 0, note: '[제주 추가 배송비] 배송지 우편번호가 제주(JEJU)면 추가. CHECK (jeju_extra_fee >= 0)']
  remote_extra_fee bigint [not null, default: 0, note: '[도서산간 추가 배송비] 배송지 우편번호가 제주 외 도서산간(REMOTE)이면 추가. CHECK (remote_extra_fee >= 0)']
  created_by varchar(20) [note: '[등록 관리자] 정책 등록자 (브랜드 관리자·운영자 테이블을 만들 때 연결)']
  updated_by varchar(20) [note: '[수정 관리자] 정책 수정자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 정책 등록일시']
  updated_at datetime [note: '[수정일시] 정책 수정일시']
}

Table shipping_extra_zipcode [note: '[추가 배송비 지역 우편번호] 제주·도서산간 우편번호 목록. 플랫폼 공통 기준표(운영자 관리, 택배사 기준을 반영). 주문 시 배송지 우편번호로 조회해 지역 유형을 정하고, 브랜드 배송 정책의 해당 추가 배송비를 더함. 목록에 없으면 추가 배송비 없음'] {
  zipcode char(5) [pk, note: '[배송지 우편번호] 추가 배송비가 붙는 5자리 국가기초구역번호. 배송지·주문 배송지의 우편번호로 바로 조회']
  area_type varchar(10) [not null, note: '[지역 유형] JEJU/REMOTE (제주/도서산간)']
  area_name varchar(100) [not null, note: '[지역 이름] 운영 화면 표시용(예: 제주 제주시, 경북 울릉군)']
  created_by varchar(20) [note: '[등록 관리자] 우편번호 등록 운영자 (운영자 테이블을 만들 때 연결)']
  updated_by varchar(20) [note: '[수정 관리자] 우편번호 수정 운영자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 우편번호 등록일시']
  updated_at datetime [note: '[수정일시] 우편번호 수정일시']

  indexes {
    area_type [name: 'ix_shipping_extra_zipcode_type', note: '유형별 목록 관리']
  }
}


// =====================================================================
// 상품 - 상품 기본 (상품 1행 + 컬러 N + 사이즈 N + 옵션(컬러 × 사이즈) N. 상품은 브랜드 1개·말단 카테고리 1개에 속함)
// =====================================================================

Table product [note: '[상품] 브랜드가 등록한 판매 상품. 말단(3단계) 카테고리 하나에 속함(앱 검증). 품목 유형은 카테고리에서, 고시 유형은 상품 정보 고시에서'] {
  product_code varchar(20) [pk, note: '[상품 코드] 숫자만. 앱이 발급(채번, AUTO_INCREMENT 아님), 브랜드 접두사 없음, 변경 불가. 상품 URL에 사용']
  brand_id varchar(30) [not null, note: '[브랜드 아이디] 상품을 판매하는 브랜드']
  category_code varchar(30) [not null, note: '[카테고리 코드] 말단(3단계) 카테고리만(앱 검증). 상위 카테고리 목록은 트리로 하위를 모아 조회']
  style_no varchar(50) [note: '[브랜드 품번] 브랜드가 쓰는 자체 품번(선택). 브랜드 안에서 중복 불가']
  gender varchar(10) [not null, note: '[성별] WOMEN/MEN/UNISEX (여성/남성/공용). UNISEX는 여성·남성 메뉴 모두 노출']
  list_image_url varchar(500) [note: '[목록 이미지] 상품 목록 썸네일 URL. 상세 갤러리와 다른 이미지를 쓸 때만 지정, NULL이면 갤러리 대표(MAIN) 이미지. 목록 조회를 조인 없이']
  product_name varchar(200) [not null, note: '[상품 이름] 화면 표시 상품명']
  list_price bigint [not null, note: '[정가] 원 단위']
  sale_price bigint [not null, note: '[판매가] 원 단위. CHECK (sale_price <= list_price). 할인율은 계산값, 변경 이력은 가격 이력(나중 묶음)']
  is_exclusive char(1) [not null, default: 'N', note: '[단독 여부] W컨셉 단독 판매 상품. Y/N']
  status varchar(20) [not null, default: 'ACTIVE', note: '[상태] ACTIVE/PAUSED/ENDED (판매중/판매 중지/판매 종료). 품절은 상태가 아니라 옵션 재고로 판단']
  sale_started_at datetime [not null, note: '[판매 시작일시] 고객에게 보이기 시작하는 시각. 노출 조건 status = ACTIVE AND sale_started_at <= NOW() (미래면 오픈 예정). 바로 판매하면 등록 시각을 넣음. 신상품 정렬 기준']
  ended_at datetime [note: '[판매 종료일시] status = ENDED 처리 시각']
  like_count int [not null, default: 0, note: '[찜 수] 캐시. 원본은 상품 찜']
  review_count int [not null, default: 0, note: '[리뷰 수] 캐시. 원본(리뷰)은 커뮤니티 단계']
  rating_avg decimal(2,1) [not null, default: 0.0, note: '[평균 별점] 캐시. 0.0~5.0']
  created_by varchar(20) [note: '[등록 관리자] 상품 등록자 (브랜드 관리자·운영자 테이블을 만들 때 연결)']
  updated_by varchar(20) [note: '[수정 관리자] 상품 수정자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 상품 등록일시']
  updated_at datetime [note: '[수정일시] 상품 수정일시']

  indexes {
    (brand_id, status, sale_started_at) [name: 'ix_product_brand', note: 'FK 인덱스, 브랜드관 판매중 상품 조회·신상품 정렬']
    (category_code, status, sale_started_at) [name: 'ix_product_category', note: 'FK 인덱스, 카테고리 판매중 상품 조회·신상품 정렬']
    (brand_id, style_no) [unique, name: 'uk_product_brand_style', note: '브랜드 안에서 품번 중복 금지. NULL은 중복 허용']
  }
}

Table product_detail [note: '[상품 상세] 상품 1:1. 상세페이지 아래 상품 정보 영역. 큰 본문을 목록 조회와 분리'] {
  product_code varchar(20) [pk, note: '[상품 코드] 상세페이지의 상품']
  detail_html mediumtext [not null, note: '[상세 본문] 상세페이지 HTML. 브랜드가 만든 긴 상세 이미지(<img>)와 글. 상단 갤러리 이미지는 상품 갤러리 이미지']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 상세페이지 등록일시']
  updated_at datetime [note: '[수정일시] 상세페이지 수정일시']
}

Table product_color [note: '[상품 컬러] 상품별 컬러. 브랜드가 붙인 색 이름 + 필터용 표준 색상'] {
  product_code varchar(20) [not null, note: '[상품 코드] 컬러가 속한 상품']
  color_no smallint [not null, note: '[컬러 번호] 상품별 1부터. 앱이 그 상품의 MAX+1로 부여']
  brand_color_name varchar(50) [not null, note: '[브랜드 색상 이름] 브랜드가 붙인 색 이름 (예: 크림 베이지)']
  color_code varchar(20) [not null, note: '[표준 색상 코드] 색상 필터용 (예: BEIGE)']
  sort_order smallint [not null, default: 0, note: '[정렬 순서] 컬러 표시 순서. 맨 앞이 대표 컬러']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 컬러 등록일시']
  updated_at datetime [note: '[수정일시] 컬러 수정일시']

  indexes {
    (product_code, color_no) [pk]
    color_code [name: 'ix_product_color_std', note: 'FK 인덱스, 색상 필터']
  }
}

Table product_size [note: '[상품 사이즈] 상품별 사이즈 목록. 옵션(컬러 × 사이즈)과 실측값이 이 사이즈를 참조. 실측은 컬러와 상관없이 사이즈마다'] {
  product_code varchar(20) [not null, note: '[상품 코드] 사이즈가 속한 상품']
  size_no smallint [not null, note: '[사이즈 번호] 상품별 1부터. 앱이 그 상품의 MAX+1로 부여']
  size_label varchar(20) [not null, note: '[사이즈] 화면 표시 사이즈 (예: S, M, 230, FREE)']
  sort_order smallint [not null, default: 0, note: '[정렬 순서] 사이즈 표시 순서 (S → M → L)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 사이즈 등록일시']
  updated_at datetime [note: '[수정일시] 사이즈 수정일시']

  indexes {
    (product_code, size_no) [pk, note: 'product_code 선두라 FK 인덱스 겸용']
    (product_code, size_label) [unique, name: 'uk_product_size_label', note: '상품 안에서 사이즈 이름 중복 금지']
  }
}

Table product_option [note: '[상품 옵션] 컬러 × 사이즈(상품 사이즈). 실제 주문·재고 단위'] {
  product_code varchar(20) [not null, note: '[상품 코드] 옵션이 속한 상품']
  option_no smallint [not null, note: '[옵션 번호] 상품별 1부터. 앱이 그 상품의 MAX+1로 부여']
  color_no smallint [not null, note: '[컬러 번호] 옵션의 컬러 (같은 상품의 컬러)']
  size_no smallint [not null, note: '[사이즈 번호] 옵션의 사이즈 (같은 상품의 상품 사이즈)']
  extra_price bigint [not null, default: 0, note: '[추가 금액] 판매가에 더하는 금액(원). 큰 사이즈 추가금 등']
  stock_qty int [not null, default: 0, note: '[재고 수량] 0이면 품절 표시. 변경 이력은 재고 이력(나중 묶음)']
  status varchar(20) [not null, default: 'ACTIVE', note: '[상태] ACTIVE/PAUSED (판매중/판매 중지)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 옵션 등록일시']
  updated_at datetime [note: '[수정일시] 옵션 수정일시']

  indexes {
    (product_code, option_no) [pk]
    (product_code, color_no, size_no) [unique, name: 'uk_product_option_color_size', note: '같은 컬러·사이즈 중복 금지, 컬러 FK 인덱스 겸용']
    (product_code, size_no) [name: 'ix_product_option_size', note: '사이즈 FK 인덱스']
  }
}

Table product_image [note: '[상품 갤러리 이미지] 상세페이지 상단 갤러리의 대표·추가 이미지(목록 이미지를 따로 지정하지 않으면 대표가 목록 썸네일). 컬러별 이미지는 컬러 번호, 공통 이미지는 NULL'] {
  product_code varchar(20) [not null, note: '[상품 코드] 이미지가 속한 상품']
  image_no smallint [not null, note: '[이미지 번호] 상품별 1부터. 앱이 그 상품의 MAX+1로 부여']
  color_no smallint [note: '[컬러 번호] 이 컬러를 고르면 보이는 이미지. NULL이면 공통']
  image_type varchar(20) [not null, note: '[이미지 유형] MAIN/SUB (대표/추가)']
  image_url varchar(500) [not null, note: '[이미지 주소] 이미지 URL']
  sort_order smallint [not null, default: 0, note: '[정렬 순서] 이미지 표시 순서']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 이미지 등록일시']
  updated_at datetime [note: '[수정일시] 이미지 수정일시']

  indexes {
    (product_code, image_no) [pk]
    (product_code, color_no) [name: 'ix_product_image_color', note: '컬러 FK 인덱스, 컬러별 이미지 조회']
  }
}

Table product_material [note: '[상품 소재] 부위별 소재와 혼용률. 소재는 상품 단위(컬러별 아님). 법정 고시 소재 문구는 상품 정보 고시에 브랜드 문구 그대로'] {
  product_code varchar(20) [not null, note: '[상품 코드] 소재 정보의 상품']
  part_type varchar(20) [not null, note: '[부위 유형] OUTER/LINING/FILLING/UPPER/SOLE (겉감/안감/충전재/갑피/밑창)']
  material_code varchar(30) [not null, note: '[표준 소재 코드] 소재 (예: WOOL)']
  ratio decimal(5,2) [note: '[혼용률] %. 신발·가방처럼 비율을 안 쓰면 NULL. 부위별 합계 100%는 앱 검증']
  sort_order smallint [not null, default: 0, note: '[정렬 순서] 부위 안에서 표시 순서 (보통 비율 큰 순)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 소재 등록일시']
  updated_at datetime [note: '[수정일시] 소재 수정일시']

  indexes {
    (product_code, part_type, material_code) [pk]
    material_code [name: 'ix_product_material_code', note: 'FK 인덱스, 소재 필터']
  }
}

// =====================================================================
// 상품 - 기준 데이터 (카테고리·표준 색상·표준 소재. 여성/남성은 카테고리가 아니라 상품의 성별로 구분)
// =====================================================================

Table product_category [note: '[카테고리] 계층형 3단계 (예: 의류 > 상의 > 니트). 성별 구분 없이 트리 하나(상품의 gender로 여성/남성 메뉴 구성)'] {
  category_code varchar(30) [pk, note: '[카테고리 코드] 영문 대문자·숫자·밑줄. 앱이 정하고 변경 불가 (예: TOP_KNIT)']
  parent_code varchar(30) [note: '[상위 카테고리 코드] 최상위면 NULL']
  category_name varchar(50) [not null, note: '[카테고리 이름] 화면 표시 이름 (예: 니트)']
  depth tinyint [not null, note: '[단계] 1~3 (CHECK). 최상위가 1. 상위 카테고리에서 계산되는 값을 조회용으로 저장(단계별 메뉴 조회, 3단계 제한). 상위가 바뀌면 자신과 하위 카테고리 단계를 같은 트랜잭션에서 함께 갱신(앱)']
  sort_order smallint [not null, default: 0, note: '[정렬 순서] 같은 상위 카테고리 안에서 표시 순서']
  item_type varchar(20) [not null, note: '[품목 유형] CLOTHING/SHOES/BAG/ACC (의류/신발/가방/잡화). 사이즈 체계·실측 항목을 정함. 하위는 상위와 같게(앱 검증)']
  default_notice_type varchar(20) [not null, note: '[고시 유형 기본값] 상품 등록 시 고시 입력 폼의 기본값. CLOTHING/SHOES/BAG/FASHION_ACC/JEWELRY_WATCH (의류/구두·신발/가방/패션잡화/귀금속·시계). 실제 고시 유형은 상품 정보 고시에 저장(카테고리만으로 안 갈리는 예외 상품은 상품에서 바꿈)']
  is_active char(1) [not null, default: 'Y', note: '[사용 여부] 카테고리 사용 여부. Y/N']
  created_by varchar(20) [note: '[등록 관리자] 카테고리 등록 관리자 (운영자 테이블을 만들 때 FK 연결)']
  updated_by varchar(20) [note: '[수정 관리자] 카테고리 수정 관리자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 카테고리 등록일시']
  updated_at datetime [note: '[수정일시] 카테고리 수정일시']

  indexes {
    (parent_code, category_name) [unique, name: 'uk_product_category_parent_name', note: '같은 상위 안에서 이름 중복 금지, parent_code 선두라 FK 인덱스 겸용']
  }
}

Table product_std_color [note: '[표준 색상] 색상 필터용 기준표. 브랜드가 정한 색 이름(예: 크림 베이지)은 상품 컬러에서 이 표를 참조'] {
  color_code varchar(20) [pk, note: '[표준 색상 코드] BLACK/WHITE/BEIGE 등 영문 대문자']
  color_name varchar(30) [not null, note: '[색상 이름] 표준 색상 화면 표시 이름 (예: 블랙)']
  hex_code char(7) [not null, note: '[색상값] #RRGGBB. 필터 색 칩 표시 (멀티컬러 등은 대표값)']
  sort_order smallint [not null, default: 0, note: '[정렬 순서] 필터 표시 순서']
  is_active char(1) [not null, default: 'Y', note: '[사용 여부] 표준 색상 사용 여부. Y/N']
  created_by varchar(20) [note: '[등록 관리자] 표준 색상 등록 관리자 (운영자 테이블을 만들 때 FK 연결)']
  updated_by varchar(20) [note: '[수정 관리자] 표준 색상 수정 관리자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 표준 색상 등록일시']
  updated_at datetime [note: '[수정일시] 표준 색상 수정일시']
}

Table product_std_material [note: '[표준 소재] 소재 필터·혼용률 입력용 기준표. 상품별 부위·비율은 상품 소재에서 이 표를 참조'] {
  material_code varchar(30) [pk, note: '[표준 소재 코드] WOOL/CASHMERE/COW_LEATHER 등 영문 대문자. 앱이 정함, 변경 불가']
  material_name varchar(30) [not null, note: '[소재 이름] 표준 소재 화면 표시 이름 (예: 울)']
  sort_order smallint [not null, default: 0, note: '[정렬 순서] 필터 표시 순서']
  is_active char(1) [not null, default: 'Y', note: '[사용 여부] 표준 소재 사용 여부. Y/N']
  created_by varchar(20) [note: '[등록 관리자] 표준 소재 등록 관리자 (운영자 테이블을 만들 때 FK 연결)']
  updated_by varchar(20) [note: '[수정 관리자] 표준 소재 수정 관리자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 표준 소재 등록일시']
  updated_at datetime [note: '[수정일시] 표준 소재 수정일시']

  indexes {
    material_name [unique, name: 'uk_product_std_material_name']
  }
}

// =====================================================================
// 상품 - 실측 (상품 사이즈(상품 기본) × 실측 항목 = 실측값. 실측 항목 기준표 → 카테고리별 항목. 단위는 모두 cm)
// =====================================================================

Table product_size_measure [note: '[상품 실측] 사이즈 × 실측 항목의 값. 상세페이지 사이즈 정보 표의 칸. 상품 카테고리의 실측 항목만 입력(앱 검증)'] {
  product_code varchar(20) [not null, note: '[상품 코드] 실측값의 상품']
  size_no smallint [not null, note: '[사이즈 번호] 실측값의 사이즈']
  measure_item_code varchar(30) [not null, note: '[실측 항목 코드] 실측값의 항목']
  measure_value decimal(5,1) [not null, note: '[실측값] cm']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 실측값 등록일시']
  updated_at datetime [note: '[수정일시] 실측값 수정일시']

  indexes {
    (product_code, size_no, measure_item_code) [pk, note: '(product_code, size_no) 선두라 사이즈 FK 인덱스 겸용']
    measure_item_code [name: 'ix_product_size_measure_item', note: '실측 항목 FK 인덱스']
  }
}

Table product_measure_item [note: '[실측 항목] 사이즈 표의 열이 되는 실측 항목 기준표. 관리자가 수정하는 기준 데이터. 단위는 모두 cm(신발 사이즈 mm는 사이즈 이름)'] {
  measure_item_code varchar(30) [pk, note: '[실측 항목 코드] TOTAL_LENGTH/SHOULDER/CHEST/SLEEVE/WAIST/HIP/THIGH/RISE/HEM/HEEL_HEIGHT/BAG_WIDTH/BAG_HEIGHT/BAG_DEPTH/STRAP_LENGTH 등 영문 대문자. 앱이 정함, 변경 불가']
  measure_item_name varchar(30) [not null, note: '[실측 항목 이름] 화면 표시 이름 (예: 어깨 단면)']
  item_type varchar(20) [not null, note: '[품목 유형] CLOTHING/SHOES/BAG/ACC (의류/신발/가방/잡화). 실측 항목이 쓰이는 품목, 관리 화면 필터']
  measure_guide varchar(200) [note: '[측정 방법] 재는 법 안내 (예: 겨드랑이 아래 1cm 지점 가로 단면)']
  sort_order smallint [not null, default: 0, note: '[정렬 순서] 관리 화면 표시 순서']
  is_active char(1) [not null, default: 'Y', note: '[사용 여부] 실측 항목 사용 여부. Y/N']
  created_by varchar(20) [note: '[등록 관리자] 실측 항목 등록 관리자 (운영자 테이블을 만들 때 FK 연결)']
  updated_by varchar(20) [note: '[수정 관리자] 실측 항목 수정 관리자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 실측 항목 등록일시']
  updated_at datetime [note: '[수정일시] 실측 항목 수정일시']

  indexes {
    measure_item_name [unique, name: 'uk_product_measure_item_name']
  }
}

Table product_category_measure_item [note: '[카테고리 실측 항목] 카테고리별로 사이즈 표에 쓰는 실측 항목. 어느 단계에든 지정하고, 상품의 말단 카테고리에서 위로 올라가며 가장 가까운 카테고리의 항목을 씀(앱. 예: 상의에 지정하면 니트·셔츠가 함께 씀)'] {
  category_code varchar(30) [not null, note: '[카테고리 코드] 실측 항목을 지정한 카테고리']
  measure_item_code varchar(30) [not null, note: '[실측 항목 코드] 카테고리에서 쓰는 실측 항목']
  sort_order smallint [not null, default: 0, note: '[정렬 순서] 사이즈 표의 열 순서']
  created_by varchar(20) [note: '[등록 관리자] 카테고리 실측 항목 등록 관리자 (운영자 테이블을 만들 때 FK 연결)']
  updated_by varchar(20) [note: '[수정 관리자] 카테고리 실측 항목 수정 관리자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 카테고리 실측 항목 등록일시']
  updated_at datetime [note: '[수정일시] 카테고리 실측 항목 수정일시']

  indexes {
    (category_code, measure_item_code) [pk, note: 'category_code 선두라 FK 인덱스 겸용']
    measure_item_code [name: 'ix_product_category_measure_item', note: '실측 항목 FK 인덱스']
  }
}


// =====================================================================
// 상품 - 정보 고시 (전자상거래법 상품정보제공 고시. 상품 1:1, 고시 유형마다 필수 항목이 다름. 값은 브랜드 문구 그대로)
// =====================================================================

Table product_notice [note: '[상품 정보 고시] 상품 1:1. 상세페이지 상품정보제공 고시 표. 고시 유형(의류/구두·신발/가방/패션잡화/귀금속·시계)마다 항목이 조금씩 달라 공통 항목은 컬럼, 유형별 항목은 NULL 가능 컬럼 + CHECK로 필수 강제. 화면 라벨(예: 신발 "제품 주소재")은 앱에서 유형별로'] {
  product_code varchar(20) [pk, note: '[상품 코드] 고시 대상 상품']
  notice_type varchar(20) [not null, note: '[고시 유형] CLOTHING/SHOES/BAG/FASHION_ACC/JEWELRY_WATCH (의류/구두·신발/가방/패션잡화/귀금속·시계). 상품 등록 시 카테고리의 고시 유형 기본값으로 시작, 예외 상품은 바꿈']
  item_kind varchar(100) [note: '[종류] 가방·패션잡화 필수(예: 숄더백, 벨트). CHECK (notice_type NOT IN (BAG, FASHION_ACC) OR item_kind IS NOT NULL)']
  material_text varchar(500) [not null, note: '[소재] 브랜드 문구 그대로(의류 제품 소재, 신발 겉감·안감 주소재, 귀금속 소재·순도·밴드 재질). 초안은 상품 소재에서 만듦']
  color_text varchar(200) [note: '[색상] 의류·구두/신발·가방 필수. CHECK (notice_type NOT IN (CLOTHING, SHOES, BAG) OR color_text IS NOT NULL)']
  size_text varchar(500) [not null, note: '[치수] 의류 치수, 신발 발길이(mm)·굽 높이(cm), 가방 크기(가로×세로×폭), 잡화·귀금속 치수']
  weight_text varchar(100) [note: '[중량] 귀금속·시계 필수']
  manufacturer_name varchar(100) [not null, note: '[제조자 이름] 제조사(자)']
  importer_name varchar(100) [note: '[수입자 이름] 수입품만. 국내 제조면 NULL']
  made_in varchar(100) [not null, note: '[제조국] 브랜드 문구 그대로(예: 대한민국, 중국)']
  care_text varchar(1000) [not null, note: '[취급 시 주의사항] 의류는 세탁 방법 포함, 귀금속·시계는 착용 시 주의사항']
  manufactured_ym varchar(50) [note: '[제조연월] 의류 필수. 문구로 받음(예: 2026년 9월, 2026년 9월 이후 생산분). CHECK (notice_type <> CLOTHING OR manufactured_ym IS NOT NULL)']
  spec_text varchar(500) [note: '[주요 사양] 귀금속·시계 필수(귀금속·보석 등급, 시계 기능·방수 등)']
  is_warranty_card char(1) [note: '[보증서 제공 여부] Y/N. 귀금속·시계 필수. CHECK (notice_type <> JEWELRY_WATCH OR (weight_text, spec_text, is_warranty_card 모두 NOT NULL))']
  quality_warranty varchar(500) [not null, note: '[품질보증기준] 브랜드 문구 그대로(예: 관련 법 및 소비자분쟁해결기준에 따름)']
  as_manager_name varchar(100) [not null, note: '[A/S 책임자 이름] 보통 브랜드(사업자) 이름. 브랜드 정책 묶음이 생기면 브랜드 기본값을 복사']
  as_phone varchar(30) [not null, note: '[A/S 전화번호] 사업장 고객센터 번호라 평문']
  created_by varchar(20) [note: '[등록 관리자] 고시 등록자 (브랜드 관리자·운영자 테이블을 만들 때 연결)']
  updated_by varchar(20) [note: '[수정 관리자] 고시 수정자']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 고시 등록일시']
  updated_at datetime [note: '[수정일시] 고시 수정일시']

  indexes {
    notice_type [name: 'ix_product_notice_type', note: '유형별 누락 점검·일괄 수정(관리자)']
  }
}


// =====================================================================
// 상품 - 고객 연결 (회원이 상품에 남기는 반응: 찜. 재입고 알림은 나중에 이 묶음에)
// =====================================================================

Table product_like [note: '[상품 찜] 회원의 찜 목록(위시리스트). 상품 단위(컬러·사이즈 선택 전). 회원만(로그인 필요). 찜 해제는 행 삭제, 추가·삭제와 같은 트랜잭션에서 상품 찜 수 캐시 ±1. 판매 종료 상품도 행은 남고 목록에 판매 종료로 표시'] {
  member_id varchar(20) [not null, note: '[회원 아이디] 찜한 회원. 탈퇴 시 행 삭제']
  product_code varchar(20) [not null, note: '[상품 코드] 찜한 상품']
  liked_price bigint [not null, note: '[찜 당시 판매가] 찜한 순간의 상품 판매가 복사. 지금 판매가와 비교해 "찜한 뒤 ○원 내림" 표시·가격 인하 알림']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 찜한 일시. 찜 목록 최근 순 정렬']
  updated_at datetime [note: '[수정일시] 찜 수정일시']

  indexes {
    (member_id, product_code) [pk, note: '같은 상품 중복 찜 금지']
    (member_id, created_at) [name: 'ix_product_like_member', note: '내 찜 목록 최근 찜한 순']
    product_code [name: 'ix_product_like_product', note: 'FK 인덱스, 가격 인하·재입고 알림 대상 회원 조회']
  }
}


// =====================================================================
// 주문 - 장바구니 (회원만 DB에 저장. 비회원 장바구니는 브라우저 저장, 로그인 시 합침)
// =====================================================================

Table cart_item [note: '[장바구니 상품] 회원이 담은 옵션. 같은 옵션을 다시 담으면 수량 증가. 가격·할인·배송비·브랜드별 합계는 저장하지 않고 화면에서 현재가로 계산. 바로구매는 장바구니를 거치지 않음'] {
  member_id varchar(20) [not null, note: '[회원 아이디] 장바구니 주인 회원']
  product_code varchar(20) [not null, note: '[상품 코드] 담은 상품']
  option_no smallint [not null, note: '[옵션 번호] 담은 옵션 (컬러 × 사이즈)']
  quantity smallint [not null, default: 1, note: '[수량] CHECK (quantity >= 1). 재고 초과는 주문 시 확인(앱)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 장바구니에 담은 일시']
  updated_at datetime [note: '[수정일시] 수량 변경일시']

  indexes {
    (member_id, product_code, option_no) [pk, note: 'member_id 선두라 회원 FK 인덱스 겸용']
    (product_code, option_no) [name: 'ix_cart_item_option', note: '옵션 FK 인덱스']
  }
}

// =====================================================================
// 주문 - 주문 기본 (주문 1건 = 결제 1번 → 브랜드별 묶음 → 주문 상세. 주문 당시 값은 스냅샷으로 복사해 5년 보관)
// 결제·배송·혜택은 나중에 별도 영역으로 만들고, 주문에는 이어질 값(할인 금액·배송비·결제 단계 상태)만 둔다
// =====================================================================

Table orders [note: '[주문] 주문 1건 = 결제 1번. 회원 주문과 비회원 주문(주문 번호 + 비밀번호로 조회). 주문자 정보는 주문 당시 스냅샷(회원은 회원 정보에서 복사, 비회원은 직접 입력 + 휴대폰 인증). order는 MySQL 예약어라 orders'] {
  order_no varchar(20) [pk, note: '[주문 번호] 앱이 채번(예: 20261125 + 일련번호, AUTO_INCREMENT 아님). 변경 불가']
  member_id varchar(20) [note: '[회원 아이디] 주문한 회원. 비회원 주문이면 NULL. CHECK (member_id IS NOT NULL OR guest_password_hash IS NOT NULL)에 쓰이므로 FK는 참조 동작 없이']
  guest_password_hash varchar(255) [note: '[비회원 주문 비밀번호(해시)] bcrypt 해시. 비회원 주문조회(주문 번호 + 비밀번호). 회원 주문이면 NULL']
  order_type varchar(20) [not null, default: 'NORMAL', note: '[주문 유형] NORMAL/GIFT (일반/선물하기). 선물하기 흐름(받는 사람 입력)은 나중 묶음']
  order_channel varchar(20) [not null, note: '[주문 경로] PC_WEB/MOBILE_WEB/APP_IOS/APP_ANDROID']
  orderer_name varchar(50) [not null, note: '[주문자 이름] 주문 당시 스냅샷']
  orderer_phone_enc varchar(255) [not null, note: '[주문자 휴대폰 번호(암호화)] AES-256 암호문. 주문 당시 스냅샷']
  orderer_phone_hash char(64) [not null, note: '[주문자 휴대폰 번호 검색값] HMAC-SHA256(서버 비밀 키). 비회원 주문 찾기·고객센터 검색']
  orderer_email varchar(100) [not null, note: '[주문자 이메일] 주문 확인 메일 발송. 주문 당시 스냅샷']
  orderer_verified_at datetime [note: '[주문자 인증일시] 비회원 주문 시 휴대폰 인증 완료 시각. 회원은 가입 시 인증했으므로 NULL']
  product_amount bigint [not null, note: '[상품 금액] (판매가 + 추가 금액) × 수량의 합계. 주문은 전체, 주문 브랜드는 그 브랜드 합계']
  discount_amount bigint [not null, default: 0, note: '[할인 금액] 쿠폰 등 할인 합계(포인트 제외). 쿠폰 연결은 혜택 영역에서. 주문은 전체, 주문 상세은 그 상품에 배분된 금액']
  point_amount bigint [not null, default: 0, note: '[포인트 사용 금액] 회원만 사용. CHECK (point_amount = 0 OR member_id IS NOT NULL). 쿠폰 할인과 따로 두는 이유: 주문 내역에 따로 표시, 취소 시 포인트로 환원. 잔액·적립/사용 내역은 혜택 영역']
  shipping_fee bigint [not null, default: 0, note: '[배송비] 주문 브랜드 배송비(지역 추가 포함)의 합계. 캐시, 주문 생성 시 함께 계산. 고객이 낸 배송비는 이 한 번']
  pay_amount bigint [not null, note: '[결제 금액] CHECK (pay_amount = product_amount - discount_amount - point_amount + shipping_fee). 실제로 낸 돈. 결제 수단·PG 거래는 결제 영역']
  status varchar(20) [not null, default: 'PAYMENT_WAITING', note: '[상태] PAYMENT_WAITING/PAID/CANCELLED (결제 대기/결제 완료/주문 취소). 결제 단계만, 출고·배송 진행은 주문 상세 상태. 무통장입금은 입금 전까지 결제 대기']
  paid_at datetime [note: '[결제일시] status = PAID 처리 시각']
  cancelled_at datetime [note: '[취소일시] status = CANCELLED 처리 시각 (입금 기한 초과 자동 취소 포함)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 주문일시']
  updated_at datetime [note: '[수정일시] 주문 수정일시']

  indexes {
    (member_id, created_at) [name: 'ix_orders_member', note: '회원 FK 인덱스, 내 주문 목록(최신순)']
    (status, created_at) [name: 'ix_orders_status', note: '입금 기한 초과 자동 취소 배치·관리자 조회']
    orderer_phone_hash [name: 'ix_orders_orderer_phone', note: '비회원 주문 찾기·고객센터 검색']
  }
}

Table order_brand [note: '[주문 브랜드] 주문 안의 브랜드별 묶음. 브랜드별 상품 합계 + 배송비(장바구니·주문서의 브랜드별 합계). 브랜드가 따로 출고하므로 배송 영역의 출고·송장이 이 단위에 연결될 예정'] {
  order_no varchar(20) [not null, note: '[주문 번호] 브랜드 묶음의 주문']
  brand_id varchar(30) [not null, note: '[브랜드 아이디] 상품을 판매·출고하는 브랜드']
  product_amount bigint [not null, note: '[상품 금액] 이 브랜드 주문 상세의 (판매가 + 추가 금액) × 수량 합계']
  shipping_fee bigint [not null, default: 0, note: '[배송비] 원본. 이 주문에서 이 브랜드에 매긴 배송비 = 기본 배송비(무료 배송 기준 반영) + 지역 추가 배송비. 주문 당시 브랜드 배송 정책으로 계산한 결과를 고정(정책이 바뀌어도 그대로, 반품·정산 근거)']
  extra_shipping_fee bigint [not null, default: 0, note: '[지역 추가 배송비] 배송비 중 제주·도서산간 추가분(주문서·주문 내역 표시용). CHECK (extra_shipping_fee <= shipping_fee)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 주문일시']
  updated_at datetime [note: '[수정일시] 브랜드 묶음 수정일시']

  indexes {
    (order_no, brand_id) [pk, note: 'order_no 선두라 주문 FK 인덱스 겸용']
    (brand_id, created_at) [name: 'ix_order_brand_brand', note: '브랜드 FK 인덱스, 브랜드별 주문 조회(최신순)']
  }
}

Table order_item [note: '[주문 상세] 주문한 옵션 한 줄. 상품·옵션이 바뀌거나 판매 종료돼도 주문 내역이 그대로 보이게 주문 당시 값을 스냅샷으로 저장'] {
  order_no varchar(20) [not null, note: '[주문 번호] 주문 상세의 주문']
  item_no smallint [not null, note: '[주문 상세 번호] 주문별 1부터. 앱이 부여']
  brand_id varchar(30) [not null, note: '[브랜드 아이디] 상품의 브랜드 (주문 브랜드 복합 FK)']
  product_code varchar(20) [not null, note: '[상품 코드] 주문한 상품']
  option_no smallint [not null, note: '[옵션 번호] 주문한 옵션 (컬러 × 사이즈)']
  product_name varchar(200) [not null, note: '[상품 이름] 주문 당시 스냅샷']
  brand_color_name varchar(50) [not null, note: '[브랜드 색상 이름] 주문 당시 스냅샷']
  size_label varchar(20) [not null, note: '[사이즈] 주문 당시 스냅샷']
  list_price bigint [not null, note: '[정가] 주문 당시 스냅샷']
  sale_price bigint [not null, note: '[판매가] 주문 당시 스냅샷. CHECK (sale_price <= list_price)']
  extra_price bigint [not null, default: 0, note: '[추가 금액] 주문 당시 옵션 추가 금액 스냅샷']
  quantity smallint [not null, note: '[수량] CHECK (quantity >= 1)']
  discount_amount bigint [not null, default: 0, note: '[할인 금액] 이 상품에 배분된 할인(쿠폰 등, 포인트 제외). 부분 취소 시 환불 금액 계산 근거']
  point_amount bigint [not null, default: 0, note: '[포인트 사용 금액] 이 상품에 배분된 포인트. 부분 취소 시 포인트로 환원할 금액']
  status varchar(20) [not null, default: 'ORDERED', note: '[상태] ORDERED/PREPARING/SHIPPING/DELIVERED/CONFIRMED/CANCELLED/RETURNED (주문 접수/상품 준비중/배송중/배송 완료/구매 확정/취소/반품). 세부 값은 배송 영역에서 확정']
  confirmed_at datetime [note: '[구매확정일시] status = CONFIRMED 처리 시각 (배송 완료 후 자동 확정 포함). 회원 등급 점수·리뷰 작성 기준']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 주문일시']
  updated_at datetime [note: '[수정일시] 주문 상세 수정일시']

  indexes {
    (order_no, item_no) [pk, note: 'order_no 선두라 주문 FK 인덱스 겸용']
    (order_no, brand_id) [name: 'ix_order_item_brand', note: '주문 브랜드 복합 FK 인덱스']
    (product_code, option_no) [name: 'ix_order_item_option', note: '옵션 FK 인덱스, 상품별 판매 조회']
  }
}

Table order_delivery [note: '[주문 배송지] 주문 1:1. 주문 당시 배송지 스냅샷(회원 배송지에서 복사하거나 직접 입력). 주문자와 동일 체크는 화면 기능이라 저장하지 않음'] {
  order_no varchar(20) [pk, note: '[주문 번호] 배송지의 주문']
  recipient_name varchar(50) [not null, note: '[배송지 받는 분 이름] 주문 당시 스냅샷']
  recipient_phone_enc varchar(255) [not null, note: '[배송지 받는 분 연락처(암호화)] AES-256 암호문. 주문 당시 스냅샷']
  zipcode char(5) [not null, note: '[배송지 우편번호] 5자리 국가기초구역번호']
  address1 varchar(200) [not null, note: '[배송지 기본 주소] 도로명 주소']
  address2 varchar(200) [note: '[배송지 상세 주소]']
  delivery_request varchar(100) [note: '[배송지 배송 요청사항] 주문 시 입력(회원 배송지 기본값에서 시작)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 배송지 등록일시']
  updated_at datetime [note: '[수정일시] 배송지 수정일시 (출고 전 배송지 변경)']
}

// =====================================================================
// 결제 - 결제 기본 (주문 1건 = 결제 수단 1개. 결제 시도마다 1행, 성공은 1개. 부분 취소는 회차별 취소 내역)
// 흐름: 주문 생성(결제 대기) → 결제창 인증 → 서버가 금액 검증 후 PG 승인 요청 → 성공이면 결제·주문을 같은 트랜잭션에서 결제 완료
// 카드 혜택·회원 결제 설정은 나중에
// =====================================================================

Table payment [note: '[결제] 주문의 결제 시도 1건. 결제 수단은 하나만(복합 결제 없음, 포인트는 주문의 포인트 사용 금액). 실패 후 재시도·수단 변경이면 행이 하나 더 생기고, 성공한(결제 완료 이후 상태) 결제는 주문당 1개. 결제·환불 기록은 5년 보관'] {
  order_no varchar(20) [not null, note: '[주문 번호] 결제한 주문']
  payment_no smallint [not null, note: '[결제 번호] 주문별 1부터, 결제 시도마다 앱이 부여']
  pay_method varchar(20) [not null, note: '[결제 수단] CARD/EASY_PAY/VIRTUAL_ACCOUNT/BANK_TRANSFER/MOBILE (신용카드/간편결제/가상계좌/실시간 계좌이체/휴대폰 결제)']
  easy_pay_provider varchar(20) [note: '[간편결제 종류] NAVERPAY/SSGPAY/SMILEPAY/KAKAOPAY/TOSSPAY/SAMSUNGPAY/PAYCO. CHECK ((pay_method = \'EASY_PAY\') = (easy_pay_provider IS NOT NULL))']
  pg_provider varchar(20) [not null, note: '[PG사] TOSS/INICIS/KCP/NICE 등 결제를 처리한 PG']
  pg_tx_id varchar(100) [note: '[PG 거래 번호] PG가 거래마다 발급하는 키(예: 토스페이먼츠 paymentKey). 취소 요청에 사용. 결제창 인증 전이면 NULL']
  pay_amount bigint [not null, note: '[결제 금액] 이 결제로 요청·승인된 금액. 승인 전에 주문의 결제 금액과 PG가 보낸 금액이 같은지 서버가 검증(금액 위변조 방지)']
  cancelled_amount bigint [not null, default: 0, note: '[누적 취소 금액] 캐시. 완료된 결제 취소 내역의 취소 금액 합계, 취소 내역과 같은 트랜잭션에서 갱신. CHECK (cancelled_amount <= pay_amount). 남은 결제 금액 = 결제 금액 - 누적 취소 금액']
  status varchar(20) [not null, default: 'WAITING', note: '[상태] WAITING/PAID/FAILED/PARTIAL_CANCELLED/CANCELLED (결제 대기/결제 완료/결제 실패/부분 취소/결제 취소). 가상계좌는 입금 전까지 결제 대기. 취소 시각은 결제 취소 내역의 취소일시(완료된 마지막 회차)라 결제에는 취소일시를 두지 않음. 수단이 하나라 부분결제 상태는 없음. 주문 상태 PAYMENT_WAITING과 톤을 맞춰 WAITING(결제 자체가 대상이라 접두사 없음)']
  fail_reason varchar(200) [note: '[실패 사유] status = FAILED일 때 PG 응답 코드·메시지 (예: 한도 초과, 사용자 취소)']
  bank_code char(3) [note: '[은행 코드] 실시간 계좌이체 은행(PG 승인 응답). 금융결제원 3자리 은행 코드. 계좌이체는 은행 하나뿐이라 결제에 둠(나중에 분리 가능). 환불은 PG가 같은 계좌로. 카드·가상계좌 정보는 1:1 테이블로 분리']
  paid_at datetime [note: '[결제일시] status = PAID 처리 시각 (카드는 승인, 가상계좌는 입금 웹훅 수신)']
  failed_at datetime [note: '[실패일시] status = FAILED 처리 시각']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 결제 요청(결제창 호출) 일시']
  updated_at datetime [note: '[수정일시] 결제 상태 변경일시']

  indexes {
    (order_no, payment_no) [pk, note: 'order_no 선두라 주문 FK 인덱스 겸용']
    (pg_provider, pg_tx_id) [unique, name: 'uk_payment_pg_tx', note: 'PG 거래 1건 = 결제 1행. 웹훅으로 결제 찾기. pg_tx_id가 NULL인 행은 중복 허용']
    `CASE WHEN status IN ('PAID', 'PARTIAL_CANCELLED', 'CANCELLED') THEN order_no END` [unique, name: 'ux_payment_success', note: '주문당 성공한 결제 1개. MySQL 8.0.13+ 함수 기반 인덱스 (NULL은 중복 허용)']
  }
}

Table payment_card [note: '[결제 카드 정보] 결제 1:1. 신용카드 결제와 카드로 낸 간편결제(예: 카카오페이 안의 신한카드)일 때만 행이 생김. 모두 PG 승인 응답으로 받은 값이고, 결제 완료 처리와 같은 트랜잭션에서 저장. 카드 결제면 행이 꼭 있어야 하는 것은 앱 검증'] {
  order_no varchar(20) [not null, note: '[주문 번호] 카드로 결제한 주문']
  payment_no smallint [not null, note: '[결제 번호] 카드로 결제한 결제 시도']
  card_company_code varchar(10) [not null, note: '[카드사 코드] PG가 주는 카드사 코드. 주문 내역 표시(신한카드), 카드사별 통계, 카드 혜택 정산 근거']
  card_no_masked varchar(30) [note: '[카드 번호(마스킹)] PG가 마스킹해서 주는 번호(예: 1234-56**-****-7890). 원래 번호는 저장하지 않음(카드 정보는 PG 결제창에서만 입력). 일부 간편결제는 주지 않아 NULL 가능']
  installment_months tinyint [not null, default: 0, note: '[할부 개월 수] 고객이 결제창에서 고른 값. 0이면 일시불. 주문 내역 표시, 무이자 할부 비용 정산 근거']
  approval_no varchar(20) [not null, note: '[카드 승인번호] 카드사가 발급하는 승인번호. 고객 카드 명세서에 찍히는 번호라 고객 문의·카드사 분쟁(차지백) 대조용. PG 거래 번호와 다른 값']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 카드 승인 정보 저장일시']
  updated_at datetime [note: '[수정일시] 카드 정보 수정일시']

  indexes {
    (order_no, payment_no) [pk, note: '결제 PK와 같음 (1:1)']
    approval_no [name: 'ix_payment_card_approval', note: '카드 승인번호로 결제 찾기. 고객은 주문 번호를 몰라도 카드 명세서의 승인번호는 알아서, 고객센터가 "명세서에 찍힌 이 결제가 뭔지" 문의를 받으면 승인번호 → 결제 카드 정보 → 주문 번호 → 주문 내역 순으로 찾음. 카드사 분쟁(차지백) 대조도 승인번호 기준. 결제 기록은 5년 보관이라 행이 많아 인덱스 없이는 전체 검색이 됨. 승인번호는 카드사가 매겨 카드사·날짜가 다르면 같은 번호가 나올 수 있어 UNIQUE가 아닌 일반 인덱스(같은 번호가 여러 건이면 카드사 코드·결제일시로 구분)']
  }
}

Table payment_vaccount [note: '[결제 가상계좌 정보] 결제 1:1. 가상계좌 결제일 때만 행이 생김. PG의 계좌 발급 응답(입금 전)으로 받은 값. 입금은 나중에 PG 웹훅으로 알려 오고 그때 결제가 결제 완료. 가상계좌 환불은 고객 계좌로 보내야 해서 회원 환불 계좌 사용'] {
  order_no varchar(20) [not null, note: '[주문 번호] 가상계좌로 결제한 주문']
  payment_no smallint [not null, note: '[결제 번호] 가상계좌로 결제한 결제 시도']
  bank_code char(3) [not null, note: '[은행 코드] 가상계좌 입금 은행. 금융결제원 3자리 은행 코드']
  vaccount_no varchar(30) [not null, note: '[가상계좌 번호] PG가 발급한 입금 전용 계좌. 고객 계좌가 아니라 평문']
  deposit_due_at datetime [not null, note: '[입금 기한] 입금 마감 시각(예: 주문 후 24시간). 지나도 입금이 없으면 결제 실패 + 주문 취소(배치)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 가상계좌 발급일시']
  updated_at datetime [note: '[수정일시] 가상계좌 정보 수정일시']

  indexes {
    (order_no, payment_no) [pk, note: '결제 PK와 같음 (1:1)']
    deposit_due_at [name: 'ix_payment_vaccount_due', note: '입금 기한 초과 자동 취소 배치 (결제 상태 = 결제 대기와 조인)']
  }
}

Table payment_cancel [note: '[결제 취소 내역] 결제의 PG 취소(환불) 1회. 부분 취소가 여러 번 생기면 회차마다 1행(PG 취소 거래 번호·금액·시각이 회차마다 다름). 전액 취소도 1행. 반품 환불도 같은 표에 남김(배송 영역에서 연결). 환불 금액은 상품 금액 합계가 아니라 할인 회수·포인트 환원·배송비 차감을 반영한 값'] {
  order_no varchar(20) [not null, note: '[주문 번호] 취소한 결제의 주문']
  cancel_no smallint [not null, note: '[취소 번호] 주문별 1부터, 취소 요청마다 앱이 부여. 성공한 결제가 주문당 1개라 주문 기준으로 번호']
  payment_no smallint [not null, note: '[결제 번호] 취소한 결제(그 주문의 성공한 결제, 앱 검증). PK가 아니라 결제 복합 FK용']
  cancel_reason_type varchar(20) [not null, note: '[취소 사유 유형] CHANGE_MIND/OUT_OF_STOCK/DELAY/RETURN/ADMIN/ETC (단순 변심/품절/배송 지연/반품/관리자 처리/기타). 사유별 통계']
  cancel_reason varchar(200) [note: '[취소 사유] 취소 사유 유형을 보충하는 자유 입력 문장']
  cancel_amount bigint [not null, note: '[취소 금액] 이번 회차에 PG로 돌려준 돈(실제 환불액) = 결제 취소 상세 취소 금액의 합계. CHECK (cancel_amount >= 0). 0이면 포인트 결제분만 취소']
  point_refund_amount bigint [not null, default: 0, note: '[포인트 환원 금액] 이번 회차에 포인트로 돌려준 금액(주문 상세의 포인트 사용 금액에서). 포인트 내역은 혜택 영역']
  shipping_deduct_amount bigint [not null, default: 0, note: '[배송비 차감 금액] 환불에서 뺀 배송비. 남은 상품이 무료 배송 기준보다 적어지거나 반품 배송비가 생긴 경우. 회차 전체 합계(캐시, 원본은 결제 취소 상세의 상품 줄별 배송비 차감 금액)']
  status varchar(20) [not null, default: 'REQUESTED', note: '[상태] REQUESTED/COMPLETED/FAILED (취소 요청/취소 완료/취소 실패). 완료되면 결제 누적 취소 금액·상태를 같은 트랜잭션에서 갱신']
  cancel_fail_reason varchar(200) [note: '[취소 실패 사유] status = FAILED일 때 PG 응답 코드·메시지 (예: PG 점검, 이미 취소된 거래, 환불 계좌 오류). 운영자가 원인을 보고 재처리. 고객이 취소한 이유는 취소 사유']
  pg_cancel_tx_id varchar(100) [note: '[PG 취소 거래 번호] PG가 취소마다 주는 거래 번호. 정산 대사·고객 문의. 완료 전이면 NULL']
  cancelled_at datetime [note: '[취소일시] status = COMPLETED 처리 시각 (PG 취소 완료)']
  created_by varchar(20) [note: '[등록 관리자] 관리자가 처리한 취소면 운영자 아이디, 고객 요청·시스템 자동 취소면 NULL (운영자 테이블을 만들 때 FK 연결). 이력이라 updated_by 없음']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 취소 요청일시']
  updated_at datetime [note: '[수정일시] 취소 상태 변경일시']

  indexes {
    (order_no, cancel_no) [pk, note: 'order_no 선두라 주문별 취소 내역 조회 겸용']
    (order_no, payment_no) [name: 'ix_payment_cancel_payment', note: '결제 복합 FK 인덱스']
    (cancel_reason_type, created_at) [name: 'ix_payment_cancel_reason', note: '취소 사유별 집계']
  }
}

Table payment_cancel_item [note: '[결제 취소 상세] 결제 취소 내역의 상세 줄(주문 → 주문 상세와 같은 헤더-상세 관계). 취소 1회에 포함된 주문 상세와 수량. 한 번에 여러 상품을 취소해도 PG 취소는 1번이라 회차로 묶음. 수량 일부 취소(2개 중 1개)도 가능, 주문 상세 상태는 수량을 모두 취소하면 CANCELLED(앱)'] {
  order_no varchar(20) [not null, note: '[주문 번호] 취소한 주문']
  cancel_no smallint [not null, note: '[취소 번호] 이 상품이 포함된 취소 회차']
  item_no smallint [not null, note: '[주문 상세 번호] 취소한 주문 상세']
  quantity smallint [not null, note: '[수량] 이번에 취소한 수량. CHECK (quantity >= 1). 같은 주문 상세의 취소 수량 합계는 주문 수량 이하(앱 검증)']
  cancel_amount bigint [not null, note: '[취소 금액] 이 상품 몫의 환불액 = (판매가 + 추가 금액) × 취소 수량 - 배분된 할인 - 배분된 포인트 - 배송비 차감 금액. 회차 취소 금액은 이 값의 합계(앱)']
  point_refund_amount bigint [not null, default: 0, note: '[포인트 환원 금액] 이 상품 몫으로 포인트로 돌려준 금액']
  shipping_deduct_amount bigint [not null, default: 0, note: '[배송비 차감 금액] 이 상품 줄에 배분한 배송비 차감. 브랜드별 차감액을 그 브랜드의 취소 상품 줄에 나눠 담음(앱). 주문 상세의 브랜드로 모으면 브랜드별 차감액(브랜드 정산 근거). 회차 전체는 결제 취소 내역의 배송비 차감 금액']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 취소 요청일시']
  updated_at datetime [note: '[수정일시] 결제 취소 상세 수정일시']

  indexes {
    (order_no, cancel_no, item_no) [pk, note: '(order_no, cancel_no) 선두라 취소 회차 FK 인덱스 겸용']
    (order_no, item_no) [name: 'ix_payment_cancel_item_order_item', note: '주문 상세 FK 인덱스, 주문 상세별 취소 수량 합계']
  }
}

Table payment_cash_receipt [note: '[현금영수증] 현금성 결제(실시간 계좌이체·가상계좌·간편결제 페이 머니)의 현금영수증 발급 기록. 발급 1건과 부분·전액 취소 때마다 취소 발급 1건씩 행이 쌓임(PG가 국세청에 발급, 우리는 요청·결과 저장). 고객이 주문서에서 용도·번호를 입력하고, 입력하지 않으면 자진발급(국세청 지정 번호로 발급, 고객이 홈택스에서 등록). 결제 기록과 같이 5년 보관(탈퇴해도 유지)'] {
  order_no varchar(20) [not null, note: '[주문 번호] 현금영수증을 발급한 주문']
  receipt_no smallint [not null, note: '[현금영수증 번호] 주문별 1부터, 발급·취소 발급마다 앱이 부여']
  payment_no smallint [not null, note: '[결제 번호] 현금영수증 대상 결제(성공한 결제). 결제 복합 FK용']
  cancel_no smallint [note: '[취소 번호] 취소 발급이면 원인이 된 결제 취소 내역. 발급이면 NULL. CHECK ((issue_type = \'CANCEL\') = (cancel_no IS NOT NULL))에 쓰이므로 FK는 참조 동작 없이']
  issue_type varchar(20) [not null, note: '[발급 유형] ISSUE/CANCEL (발급/취소 발급). 부분 취소면 취소 금액만큼 취소 발급']
  usage_type varchar(20) [not null, note: '[용도 유형] INCOME_DEDUCTION/EXPENSE_PROOF (소득공제/지출증빙). 자진발급은 소득공제']
  id_no_type varchar(20) [not null, note: '[발급 번호 유형] PHONE/BIZ_NO/CARD/SELF (휴대폰 번호/사업자 번호/현금영수증 카드 번호/자진발급). 자진발급은 국세청 지정 번호로 발급되고 고객이 홈택스에서 등록']
  id_no_enc varchar(255) [note: '[발급 번호(암호화)] 휴대폰·사업자·현금영수증 카드 번호 AES-256 암호문. 자진발급이면 NULL. CHECK ((id_no_type = \'SELF\') = (id_no_enc IS NULL)). 대금 결제 기록이라 회원이 탈퇴해도 지우지 않고 5년 보관 후 파기(배치)']
  receipt_amount bigint [not null, note: '[발급 금액] 발급이면 현금성 결제 금액, 취소 발급이면 이번 취소 금액. CHECK (receipt_amount = supply_amount + vat_amount)']
  supply_amount bigint [not null, note: '[공급가액] 발급 금액 중 부가세를 뺀 금액. 국세청 신고 항목']
  vat_amount bigint [not null, note: '[부가세] 발급 금액 중 부가가치세']
  status varchar(20) [not null, default: 'REQUESTED', note: '[상태] REQUESTED/ISSUED/FAILED (발급 요청/발급 완료/발급 실패). 가상계좌는 입금 확인 후 발급 요청']
  receipt_fail_reason varchar(200) [note: '[발급 실패 사유] status = FAILED일 때 PG·국세청 응답 코드·메시지 (예: 잘못된 사업자 번호). 운영자가 보고 재발급']
  pg_receipt_key varchar(100) [note: '[PG 현금영수증 키] PG가 발급마다 주는 키. 취소 발급 요청·조회에 사용. 발급 완료 전이면 NULL']
  nts_approval_no varchar(20) [note: '[국세청 승인번호] 발급 완료 시 국세청 승인번호. 고객 문의·홈택스 대조용']
  receipt_url varchar(500) [note: '[현금영수증 조회 주소] PG가 주는 영수증 화면 주소(주문 내역에서 영수증 보기)']
  issued_at datetime [note: '[발급일시] status = ISSUED 처리 시각']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[등록일시] 발급 요청일시']
  updated_at datetime [note: '[수정일시] 발급 상태 변경일시']

  indexes {
    (order_no, receipt_no) [pk, note: 'order_no 선두라 주문별 현금영수증 조회 겸용']
    (order_no, payment_no) [name: 'ix_payment_cash_receipt_payment', note: '결제 복합 FK 인덱스']
    (order_no, cancel_no) [name: 'ix_payment_cash_receipt_cancel', note: '결제 취소 내역 복합 FK 인덱스']
    pg_receipt_key [unique, name: 'uk_payment_cash_receipt_key', note: 'PG 현금영수증 1건 = 1행. NULL은 중복 허용']
    (status, created_at) [name: 'ix_payment_cash_receipt_status', note: '발급 실패·미완료 재처리 배치']
  }
}

// =====================================================================
// 관계
// =====================================================================

Ref: member_login.member_id - member_account.member_id [delete: cascade]
Ref: member_social_account.member_id > member_account.member_id [delete: cascade]
Ref: member_body.member_id - member_account.member_id [delete: cascade]
Ref: member_address.member_id > member_account.member_id [delete: cascade]
Ref: member_refund_account.member_id - member_account.member_id [delete: cascade]
Ref: member_withdrawal.member_id - member_account.member_id
Ref: member_account.grade_code > member_grade.grade_code
Ref: member_grade_benefit.grade_code > member_grade.grade_code [delete: cascade]
Ref: member_grade_history.member_id > member_account.member_id [delete: cascade]
Ref: member_grade_history.grade_code > member_grade.grade_code
Ref: member_grade_history.prev_grade_code > member_grade.grade_code

Ref: product_category.parent_code > product_category.category_code

Ref: brand_shipping_policy.brand_id - brand.brand_id [delete: cascade]
Ref: product.brand_id > brand.brand_id
Ref: product.category_code > product_category.category_code
Ref: product_color.product_code > product.product_code [delete: cascade]
Ref: product_color.color_code > product_std_color.color_code
Ref: product_option.product_code > product.product_code [delete: cascade]
Ref: product_option.(product_code, color_no) > product_color.(product_code, color_no)
Ref: product_image.product_code > product.product_code [delete: cascade]
Ref: product_image.(product_code, color_no) > product_color.(product_code, color_no)
Ref: product_material.product_code > product.product_code [delete: cascade]
Ref: product_material.material_code > product_std_material.material_code
Ref: product_detail.product_code - product.product_code [delete: cascade]
Ref: product_notice.product_code - product.product_code [delete: cascade]
Ref: product_like.member_id > member_account.member_id [delete: cascade]
Ref: product_like.product_code > product.product_code [delete: cascade]

Ref: product_size.product_code > product.product_code [delete: cascade]
Ref: product_option.(product_code, size_no) > product_size.(product_code, size_no)
Ref: product_category_measure_item.category_code > product_category.category_code [delete: cascade]
Ref: product_category_measure_item.measure_item_code > product_measure_item.measure_item_code
Ref: product_size_measure.(product_code, size_no) > product_size.(product_code, size_no) [delete: cascade]
Ref: product_size_measure.measure_item_code > product_measure_item.measure_item_code

Ref: cart_item.member_id > member_account.member_id [delete: cascade]
Ref: cart_item.(product_code, option_no) > product_option.(product_code, option_no) [delete: cascade]
Ref: orders.member_id > member_account.member_id
Ref: order_delivery.order_no - orders.order_no
Ref: order_brand.order_no > orders.order_no
Ref: order_brand.brand_id > brand.brand_id
Ref: order_item.order_no > orders.order_no
Ref: order_item.(order_no, brand_id) > order_brand.(order_no, brand_id)
Ref: order_item.(product_code, option_no) > product_option.(product_code, option_no)

Ref: payment.order_no > orders.order_no
Ref: payment_card.(order_no, payment_no) - payment.(order_no, payment_no)
Ref: payment_vaccount.(order_no, payment_no) - payment.(order_no, payment_no)
Ref: payment_cancel.(order_no, payment_no) > payment.(order_no, payment_no)
Ref: payment_cancel_item.(order_no, cancel_no) > payment_cancel.(order_no, cancel_no)
Ref: payment_cancel_item.(order_no, item_no) > order_item.(order_no, item_no)
Ref: payment_cash_receipt.(order_no, payment_no) > payment.(order_no, payment_no)
Ref: payment_cash_receipt.(order_no, cancel_no) > payment_cancel.(order_no, cancel_no)

// =====================================================================
// 묶음
// =====================================================================

TableGroup member_basic [note: '고객 - 회원 기본'] {
  member_account
  member_login
  member_body
  member_refund_account
  member_withdrawal
  member_social_account
  member_address
}

TableGroup member_grading [note: '고객 - 회원 등급'] {
  member_grade
  member_grade_benefit
  member_grade_history
}

TableGroup brand_basic [note: '브랜드 - 브랜드 기본'] {
  brand
}

TableGroup brand_shipping [note: '브랜드 - 배송 정책'] {
  brand_shipping_policy
  shipping_extra_zipcode
}

TableGroup product_basic [note: '상품 - 상품 기본'] {
  product
  product_detail
  product_color
  product_size
  product_option
  product_image
  product_material
}

TableGroup product_master [note: '상품 - 기준 데이터'] {
  product_category
  product_std_color
  product_std_material
}

TableGroup product_measure [note: '상품 - 실측'] {
  product_size_measure
  product_measure_item
  product_category_measure_item
}

TableGroup product_notice [note: '상품 - 정보 고시'] {
  product_notice
}

TableGroup product_customer [note: '상품 - 고객 연결'] {
  product_like
}

TableGroup order_cart [note: '주문 - 장바구니'] {
  cart_item
}

TableGroup order_basic [note: '주문 - 주문 기본'] {
  orders
  order_brand
  order_item
  order_delivery
}

TableGroup payment_basic [note: '결제 - 결제 기본'] {
  payment
  payment_card
  payment_vaccount
  payment_cancel
  payment_cancel_item
  payment_cash_receipt
}
