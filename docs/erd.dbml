// =====================================================================
// 패션 마켓 입점형 쇼핑몰 DB 설계 (dbdiagram.io용 DBML)
// 벤치마킹: 에이블리 (소호 쇼핑몰 "마켓" 입점, 의류·신발·가방·잡화)
// 진행 중: 고객 4개 = 4개 테이블 (묶음 단위로 컬럼까지 확정하며 추가)
// 사용법: https://dbdiagram.io/d 에 접속 → 왼쪽 편집기에 이 파일 내용을 전체 붙여넣기
// DBMS: MySQL 8.0 (8.0.16 이상: CHECK 제약 적용, 8.0.13 이상: 함수 기반 인덱스)
// 이전 설계 보관: docs/archive_interior/ (인테리어몰), docs/archive_fashion/ (패션몰 Oracle), docs/archive_oracle/
// =====================================================================

Project fashion_market {
  database_type: 'MySQL'
  Note: '''
  패션 마켓 입점형 쇼핑몰 포트폴리오 DB (MySQL 8.0, InnoDB, utf8mb4 / utf8mb4_0900_ai_ci)
  - 소호 쇼핑몰(마켓)이 입점해 의류·신발·가방·잡화를 판매
  - 이름은 소문자 snake_case, PK는 BIGINT AUTO_INCREMENT
  - 상태값은 VARCHAR + CHECK, Y/N은 CHAR(1) + CHECK
  - created_at DEFAULT CURRENT_TIMESTAMP, updated_at은 ON UPDATE CURRENT_TIMESTAMP
  - 탈퇴는 soft delete + 개인정보 마스킹
  '''
}

// =====================================================================
// 고객 - 회원 기본
// =====================================================================

Table member_account [note: '[회원] 구매 고객 계정. 마켓 관리자·운영자 계정은 별도 테이블'] {
  member_id bigint [pk, increment, note: '[회원 ID]']
  email varchar(100) [not null, note: '[회원 로그인 이메일] 대소문자 무시 콜레이션(utf8mb4_0900_ai_ci)이라 UNIQUE만으로 대소문자 중복 방지. 탈퇴 시 withdrawn_{ID}@deleted.local로 마스킹']
  password_hash varchar(255) [note: '[회원 비밀번호 해시] bcrypt 등 단방향 해시. 소셜 전용 가입은 NULL']
  name varchar(50) [not null, note: '[회원 이름] 실명. 탈퇴 시 탈퇴회원']
  nickname varchar(20) [not null, note: '[회원 닉네임] 리뷰·문의에 표시. 2~12자 한글/영문/숫자/_ (앱 검증). 탈퇴 시 deleted_{ID}']
  phone_enc varchar(255) [note: '[회원 휴대폰 번호(암호화)] AES-256 암호문']
  phone_hash char(64) [note: '[회원 휴대폰 번호 해시] SHA-256. 번호로 계정 찾기·중복 확인']
  birth_date date [note: '[회원 생년월일] 선택 입력. 생일 쿠폰, 연령대 맞춤 추천 기본값']
  gender char(1) [note: '[회원 성별] F/M. 선택 입력, 맞춤 추천 피드 기본값']
  ci_hash char(64) [note: '[회원 본인인증 CI 해시] 중복 가입 방지. 탈퇴 시 NULL']
  verified_at datetime [note: '[회원 본인인증일시] NULL이면 미인증. 신규 가입 혜택은 본인인증 회원에게만']
  status varchar(20) [not null, default: 'ACTIVE', note: '[회원 상태] ACTIVE/DORMANT/SUSPENDED/WITHDRAWN. 로그인 잠금은 상태가 아니라 locked_until로 판단']
  login_fail_count tinyint [not null, default: 0, note: '[회원 연속 로그인 실패 횟수] 로그인 성공 시 0으로 초기화']
  locked_until datetime [note: '[회원 로그인 잠금 해제일시] 5회 연속 실패 시 30분 뒤 시각으로 설정']
  last_login_at datetime [note: '[회원 마지막 로그인일시] 휴면 전환 배치 기준']
  dormant_notice_sent_at datetime [note: '[회원 휴면 예정 안내일시] 마지막 로그인 11개월 시점에 안내, 1년 미접속 시 DORMANT']
  suspended_until datetime [note: '[회원 이용 정지 종료일시] SUSPENDED 기한. 지나면 배치로 ACTIVE']
  nickname_changed_at datetime [note: '[회원 닉네임 변경일시] 변경 후 30일간 재변경 불가']
  withdrawn_at datetime [note: '[회원 탈퇴일시]']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[회원 가입일시]']
  updated_at datetime [note: '[회원 정보 수정일시]']

  indexes {
    email [unique, name: 'uk_member_email']
    nickname [unique, name: 'uk_member_nickname']
    ci_hash [unique, name: 'uk_member_ci', note: 'NULL(미인증·탈퇴)은 중복 허용']
    phone_hash [name: 'ix_member_phone_hash']
    (status, last_login_at) [name: 'ix_member_dormant_target', note: '휴면 안내·전환 대상 배치 조회']
  }
}

Table member_social [note: '[소셜 계정 연동] 한 회원이 여러 소셜 계정을 연결 가능 (제공자별 1개)'] {
  member_id bigint [not null, note: '[소셜 연동 회원 ID]']
  provider varchar(20) [not null, note: '[소셜 제공자] KAKAO/NAVER/APPLE/GOOGLE. 회원당 제공자별 1개라 (회원 ID, 제공자)를 PK로 사용 (대리키 없음)']
  provider_user_id varchar(100) [not null, note: '[소셜 제공자 회원 식별값] 소셜 서비스의 회원 고유 ID']
  provider_email varchar(100) [note: '[소셜 계정 이메일] 제공자가 준 이메일 (참고용, 로그인 이메일과 다를 수 있음)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[소셜 계정 연동일시]']

  indexes {
    (provider, provider_user_id) [unique, name: 'uk_member_social_provider', note: '같은 소셜 계정은 한 회원에게만']
    (member_id, provider) [pk, note: '회원당 제공자별 1개. member_id 선두라 FK 인덱스 겸용']
  }
}

Table member_body [note: '[회원 체형] member_account와 1:1. 사이즈 추천, "나와 비슷한 체형" 리뷰 필터'] {
  member_id bigint [pk, note: '[체형 정보 회원 ID] member_account와 1:1']
  height_cm smallint [note: '[회원 키(cm)]']
  weight_kg smallint [note: '[회원 몸무게(kg)]']
  top_size varchar(10) [note: '[회원 평소 상의 사이즈] XS/S/M/L/XL/XXL/FREE']
  bottom_size varchar(10) [note: '[회원 평소 하의 사이즈] 허리 inch(25~36) 또는 XS~XXL']
  shoe_size_mm smallint [note: '[회원 평소 신발 사이즈(mm)] 220~300, 5 단위 (앱 검증)']
  foot_width varchar(10) [note: '[회원 발볼 너비] NARROW/NORMAL/WIDE']
  is_review_public char(1) [not null, default: 'Y', note: '[회원 체형 리뷰 공개 여부] Y/N. Y면 리뷰에 키·몸무게·평소 사이즈 표시']
  updated_at datetime [note: '[회원 체형 수정일시]']
}

Table address [note: '[배송지] 회원당 여러 개, 기본 배송지는 1개'] {
  address_id bigint [pk, increment, note: '[배송지 ID]']
  member_id bigint [not null, note: '[배송지 소유 회원 ID]']
  address_name varchar(20) [note: '[배송지 이름] 집/회사']
  recipient_name varchar(50) [not null, note: '[배송지 받는 분 이름]']
  recipient_phone_enc varchar(255) [not null, note: '[배송지 받는 분 연락처(암호화)] AES-256 암호문']
  zipcode char(5) [not null, note: '[배송지 우편번호] 5자리 국가기초구역번호']
  address1 varchar(200) [not null, note: '[배송지 기본 주소] 도로명 주소']
  address2 varchar(200) [note: '[배송지 상세 주소]']
  is_default char(1) [not null, default: 'N', note: '[기본 배송지 여부] Y/N']
  delivery_request varchar(100) [note: '[배송지 배송 요청사항] 예: 부재 시 문 앞. 주문 시 기본값으로 복사']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '[배송지 등록일시]']
  updated_at datetime [note: '[배송지 수정일시]']

  indexes {
    member_id [name: 'ix_address_member']
    `CASE WHEN is_default = 'Y' THEN member_id END` [unique, name: 'ux_address_default', note: '회원당 기본 배송지 1개. MySQL 8.0.13+ 함수 기반 인덱스 (NULL은 중복 허용)']
  }
}

// =====================================================================
// 관계
// =====================================================================

Ref: member_social.member_id > member_account.member_id [delete: cascade]
Ref: member_body.member_id - member_account.member_id [delete: cascade]
Ref: address.member_id > member_account.member_id [delete: cascade]

// =====================================================================
// 묶음
// =====================================================================

TableGroup member_basic [note: '고객 - 회원 기본'] {
  member_account
  member_social
  member_body
  address
}
